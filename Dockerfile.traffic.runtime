# Runtime-only image for traffic-only (no controlplane) local matrix.
# Expects dist/subserver-traffic-linux (build/tags.server.traffic) and dist/libcronet.so.
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates wget \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/lib/subserver
COPY dist/subserver-traffic-linux /usr/local/bin/subserver
COPY dist/libcronet.so /usr/local/bin/libcronet.so
RUN chmod +x /usr/local/bin/subserver
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/subserver", "-config", "/etc/subserver/agent.yaml"]
