{
  "schema_version": 1,
  "tag": "http_custom",
  "protocol": "http",
  "aliases": [
    "http-custom",
    "http-constructor"
  ],
  "short_name": "HTTP custom",
  "status": "lab",
  "custom_preset": true,
  "i18n": {
    "ru": {
      "title": "HTTP конструктор",
      "description": "HTTP CONNECT: plain или TLS + uTLS fingerprint. Утилита, не DPI-стратегия."
    },
    "en": {
      "title": "HTTP constructor",
      "description": "HTTP CONNECT: plain or TLS with uTLS fingerprint. Utility only."
    }
  },
  "traits": [
    "tcp",
    "custom"
  ],
  "demux_hints": {
    "network": [
      "tcp"
    ],
    "looks_like": "http",
    "alpn": [],
    "sni_required": false,
    "first_bytes": "HTTP CONNECT/methods or TLS",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 1,
    "speed": 8,
    "mobile": 7,
    "setup": 3
  },
  "cred_fields": [
    "username",
    "password"
  ],
  "param_fields": [
    "tls_mode"
  ],
  "optional_param_fields": [
    "fingerprint"
  ],
  "param_meta": {
    "tls_mode": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "none",
        "tls"
      ],
      "default": "none",
      "ui_group": "tls",
      "ui_order": 1,
      "title": {
        "en": "TLS mode",
        "ru": "Режим TLS"
      },
      "description": {
        "en": "Plain vs TLS-wrapped utility proxy.",
        "ru": "Plain или обёртка TLS."
      }
    },
    "fingerprint": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "chrome",
        "firefox",
        "safari",
        "edge",
        "ios",
        "android",
        "random"
      ],
      "default": "chrome",
      "ui_group": "tls",
      "ui_order": 2,
      "visible_when": [
        {
          "key": "tls_mode",
          "equals": "tls"
        }
      ],
      "title": {
        "en": "uTLS fingerprint",
        "ru": "uTLS fingerprint"
      },
      "description": {
        "en": "Outbound uTLS fingerprint when tls_mode=tls.",
        "ru": "uTLS fingerprint на outbound при tls_mode=tls."
      }
    }
  },
  "requirements": {
    "tls_profile": true
  },
  "inbound_template": {
    "type": "http",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "users": [],
    "set_system_proxy": false,
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ]
    }
  },
  "outbound_template": {
    "type": "http",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "username": "{{user.username}}",
    "password": "{{user.password}}",
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ],
      "utls": {
        "enabled": true,
        "fingerprint": "{{param.fingerprint}}"
      }
    }
  },
  "client_notes": {
    "tls_mode": "none strips tls; tls attaches PEM/ACME"
  }
}
