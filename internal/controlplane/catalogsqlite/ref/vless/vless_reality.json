{
  "schema_version": 1,
  "tag": "vless_reality",
  "protocol": "vless",
  "aliases": [
    "vless-reality-tcp"
  ],
  "short_name": "VLESS Reality",
  "status": "stable",
  "i18n": {
    "ru": {
      "title": "VLESS Reality",
      "description": "Эталон обхода DPI: VLESS + Reality (ключи на inbound)."
    }
  },
  "traits": [
    "tcp",
    "tls",
    "reality"
  ],
  "demux_hints": {
    "network": [
      "tcp"
    ],
    "looks_like": "tls_clienthello",
    "alpn": [],
    "sni_required": true,
    "first_bytes": "Reality TLS fingerprint",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 10,
    "speed": 7,
    "mobile": 7,
    "setup": 6
  },
  "cred_fields": [
    "uuid",
    "uuid_xtls",
    "uuid_udp"
  ],
  "inbound_template": {
    "type": "vless",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "users": [],
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ]
    }
  },
  "outbound_template": {
    "type": "vless",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "uuid": "{{user.uuid}}",
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ],
      "utls": {
        "enabled": true,
        "fingerprint": "chrome"
      }
    },
    "packet_encoding": "xudp"
  },
  "requirements": {
    "tls_profile": true,
    "reality_assignment": true
  },
  "default_user_variants": [
    "flow-none"
  ],
  "default_client_profiles": [
    "pkt-xudp"
  ],
  "client_notes": {
    "variants": "default flow-none (compatible with official sing-box); Vision/udp-vision via enabled_user_variants"
  },
  "optional_param_fields": [
    "fingerprint"
  ],
  "param_meta": {
    "fingerprint": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "chrome",
        "firefox",
        "safari",
        "edge",
        "ios",
        "android",
        "random"
      ],
      "default": "chrome",
      "ui_group": "tls",
      "ui_order": 90,
      "title": {
        "en": "uTLS fingerprint",
        "ru": "uTLS fingerprint"
      },
      "description": {
        "en": "Outbound uTLS ClientHello fingerprint.",
        "ru": "uTLS fingerprint ClientHello на outbound."
      },
      "help": {
        "summary": {
          "en": "Outbound uTLS fingerprint. Override the template default (usually chrome).",
          "ru": "uTLS fingerprint на outbound. Переопределяет default шаблона (обычно chrome)."
        },
        "input_hint": {
          "en": "chrome|firefox|…",
          "ru": "chrome|firefox|…"
        },
        "format": "chrome"
      }
    }
  }
}
