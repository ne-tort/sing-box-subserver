{
  "schema_version": 1,
  "tag": "vless_custom",
  "protocol": "vless",
  "aliases": [
    "vless-custom",
    "vless-constructor"
  ],
  "short_name": "VLESS custom",
  "status": "lab",
  "custom_preset": true,
  "i18n": {
    "ru": {
      "title": "VLESS конструктор",
      "description": "Лабораторный конструктор: transport + TLS/Reality/plain, flow и транспортные поля через params."
    },
    "en": {
      "title": "VLESS constructor",
      "description": "Lab constructor: pick transport, TLS mode, flow, and transport-specific params."
    }
  },
  "traits": [
    "tcp",
    "udp",
    "tls",
    "custom"
  ],
  "demux_hints": {
    "network": [
      "tcp",
      "udp"
    ],
    "looks_like": "tls_clienthello",
    "alpn": [
      "h2",
      "http/1.1",
      "h3"
    ],
    "sni_required": true,
    "first_bytes": "Depends on transport/tls_mode params",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 6,
    "speed": 6,
    "mobile": 6,
    "setup": 3
  },
  "cred_fields": [
    "uuid",
    "uuid_xtls",
    "uuid_udp"
  ],
  "default_user_variants": [
    "flow-none"
  ],
  "default_client_profiles": [
    "pkt-xudp"
  ],
  "param_fields": [
    "transport",
    "tls_mode"
  ],
  "optional_param_fields": [
    "flow",
    "packet_encoding",
    "fingerprint",
    "transport_path",
    "transport_host",
    "service_name",
    "alpn",
    "multiplex",
    "ws_max_early_data"
  ],
  "param_meta": {
    "transport": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "tcp",
        "ws",
        "grpc",
        "http",
        "httpupgrade",
        "quic",
        "hysteria"
      ],
      "default": "tcp",
      "ui_group": "transport",
      "ui_order": 1,
      "title": {
        "en": "Transport",
        "ru": "Транспорт"
      },
      "description": {
        "en": "VLESS underlying transport (sing-box transport.type).",
        "ru": "Транспорт VLESS (transport.type в sing-box)."
      }
    },
    "tls_mode": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "none",
        "tls",
        "reality"
      ],
      "default": "tls",
      "ui_group": "tls",
      "ui_order": 2,
      "title": {
        "en": "TLS mode",
        "ru": "Режим TLS"
      },
      "description": {
        "en": "Plain TCP, TLS profile, or Reality assignment.",
        "ru": "Plain TCP, TLS-профиль CP или Reality."
      },
      "conflicts_with": []
    },
    "flow": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "none",
        "xtls-rprx-vision"
      ],
      "default": "none",
      "ui_group": "core",
      "ui_order": 10,
      "visible_when": [
        {
          "key": "transport",
          "equals": "tcp"
        },
        {
          "key": "tls_mode",
          "in": [
            "tls",
            "reality"
          ]
        }
      ],
      "title": {
        "en": "Flow",
        "ru": "Flow"
      },
      "description": {
        "en": "Vision flow; only valid for TCP + TLS/Reality. none = no flow.",
        "ru": "Vision flow; только TCP + TLS/Reality. none = без flow."
      }
    },
    "packet_encoding": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "none",
        "xudp",
        "packetaddr"
      ],
      "default": "xudp",
      "ui_group": "core",
      "ui_order": 11,
      "title": {
        "en": "Packet encoding",
        "ru": "Packet encoding"
      },
      "description": {
        "en": "UDP/full-cone encoding (xudp recommended). none omits the field.",
        "ru": "Кодирование UDP (обычно xudp). none — поле не пишется."
      }
    },
    "fingerprint": {
      "type": "string",
      "widget": "text",
      "default": "chrome",
      "ui_group": "tls",
      "ui_order": 20,
      "visible_when": [
        {
          "key": "tls_mode",
          "equals": "tls"
        }
      ],
      "title": {
        "en": "uTLS fingerprint",
        "ru": "uTLS fingerprint"
      },
      "description": {
        "en": "Client uTLS fingerprint (ignored for QUIC/hysteria transport).",
        "ru": "uTLS fingerprint клиента (не для QUIC/hysteria transport)."
      }
    },
    "transport_path": {
      "type": "string",
      "widget": "path",
      "default": "/",
      "ui_group": "transport",
      "ui_order": 30,
      "visible_when": [
        {
          "key": "transport",
          "in": [
            "ws",
            "http",
            "httpupgrade"
          ]
        }
      ],
      "title": {
        "en": "Path",
        "ru": "Path"
      },
      "description": {
        "en": "HTTP/WebSocket path.",
        "ru": "HTTP/WebSocket path."
      }
    },
    "transport_host": {
      "type": "string",
      "widget": "text",
      "ui_group": "transport",
      "ui_order": 31,
      "visible_when": [
        {
          "key": "transport",
          "in": [
            "ws",
            "http",
            "httpupgrade"
          ]
        }
      ],
      "title": {
        "en": "Host header",
        "ru": "Host header"
      },
      "description": {
        "en": "Host / :authority for WS/HTTP transports.",
        "ru": "Host / :authority для WS/HTTP."
      }
    },
    "service_name": {
      "type": "string",
      "widget": "text",
      "default": "GunService",
      "ui_group": "transport",
      "ui_order": 32,
      "visible_when": [
        {
          "key": "transport",
          "equals": "grpc"
        }
      ],
      "title": {
        "en": "gRPC service name",
        "ru": "gRPC service name"
      },
      "description": {
        "en": "gRPC Gun service_name.",
        "ru": "gRPC Gun service_name."
      },
      "help": {
        "input_hint": {
          "en": "gRPC service name",
          "ru": "имя gRPC service"
        }
      }
    },
    "alpn": {
      "type": "string",
      "widget": "text",
      "default": "h2,http/1.1",
      "ui_group": "tls",
      "ui_order": 21,
      "visible_when": [
        {
          "key": "tls_mode",
          "in": [
            "tls",
            "reality"
          ]
        }
      ],
      "title": {
        "en": "ALPN list",
        "ru": "Список ALPN"
      },
      "description": {
        "en": "Comma-separated ALPN values (h3 for QUIC transports).",
        "ru": "ALPN через запятую (h3 для QUIC-транспортов)."
      },
      "help": {
        "input_hint": {
          "en": "h2,http/1.1 (CSV)",
          "ru": "h2,http/1.1 (CSV)"
        }
      }
    },
    "multiplex": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "none",
        "smux"
      ],
      "default": "none",
      "ui_group": "core",
      "ui_order": 40,
      "visible_when": [
        {
          "key": "transport",
          "equals": "tcp"
        }
      ],
      "title": {
        "en": "Multiplex",
        "ru": "Multiplex"
      },
      "description": {
        "en": "smux+padding on TCP (inbound/outbound). Usually incompatible with Vision flow.",
        "ru": "smux+padding на TCP. Обычно несовместим с Vision flow."
      }
    },
    "ws_max_early_data": {
      "type": "uint16",
      "widget": "text",
      "default": "0",
      "ui_group": "transport",
      "ui_order": 33,
      "visible_when": [
        {
          "key": "transport",
          "equals": "ws"
        }
      ],
      "title": {
        "en": "WS max early data",
        "ru": "WS max early data"
      },
      "description": {
        "en": "0 disables; 2048 matches common CDN 0-RTT WS setups.",
        "ru": "0 отключает; 2048 — типичный CDN 0-RTT WS."
      }
    }
  },
  "requirements": {
    "tls_profile": true,
    "reality_assignment": true,
    "udp": true,
    "quic": true
  },
  "peer_secret_fields": {
    "hy_auth": "password"
  },
  "inbound_template": {
    "type": "vless",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "users": [],
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ]
    },
    "transport": {
      "type": "{{param.transport}}",
      "path": "{{param.transport_path}}",
      "host": "{{param.transport_host}}",
      "service_name": "{{param.service_name}}",
      "headers": {
        "Host": [
          "{{param.transport_host}}"
        ]
      },
      "password": "{{peer.hy_auth}}",
      "version": 2
    }
  },
  "outbound_template": {
    "type": "vless",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "uuid": "{{user.uuid}}",
    "flow": "{{param.flow}}",
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ],
      "utls": {
        "enabled": true,
        "fingerprint": "{{param.fingerprint}}"
      }
    },
    "transport": {
      "type": "{{param.transport}}",
      "path": "{{param.transport_path}}",
      "host": "{{param.transport_host}}",
      "service_name": "{{param.service_name}}",
      "headers": {
        "Host": [
          "{{param.transport_host}}"
        ]
      },
      "password": "{{peer.hy_auth}}",
      "version": 2
    },
    "packet_encoding": "{{param.packet_encoding}}"
  },
  "client_notes": {
    "constructor": "tls_mode=none strips tls; reality uses CP assignment; hysteria transport needs peer.hy_auth",
    "flow": "Vision only when transport=tcp and tls_mode in tls|reality",
    "demux": "compatible_with_demux when tls/reality front; UDP transports need demux UDP slot"
  }
}
