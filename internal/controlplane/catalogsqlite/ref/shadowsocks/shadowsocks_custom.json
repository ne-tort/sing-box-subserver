{
  "schema_version": 1,
  "tag": "shadowsocks_custom",
  "protocol": "shadowsocks",
  "aliases": [
    "shadowsocks-custom",
    "ss-constructor"
  ],
  "short_name": "SS custom",
  "status": "lab",
  "custom_preset": true,
  "i18n": {
    "ru": {
      "title": "Shadowsocks конструктор",
      "description": "AEAD/2022 method, network tcp|udp, multiplex и опциональный UDP-over-TCP. Без TLS-камуфляжа."
    },
    "en": {
      "title": "Shadowsocks constructor",
      "description": "AEAD/2022 method, network tcp|udp, multiplex, optional UDP-over-TCP. No TLS camouflage."
    }
  },
  "traits": [
    "tcp",
    "custom"
  ],
  "demux_hints": {
    "network": [
      "tcp"
    ],
    "looks_like": "raw_tcp",
    "alpn": [],
    "sni_required": false,
    "first_bytes": "AEAD stream",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 2,
    "speed": 7,
    "mobile": 6,
    "setup": 3
  },
  "cred_fields": [
    "password"
  ],
  "peer_secret_fields": {
    "password": "ss2022_16"
  },
  "param_fields": [
    "method"
  ],
  "optional_param_fields": [
    "network",
    "udp_over_tcp",
    "multiplex"
  ],
  "param_meta": {
    "method": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "aes-128-gcm",
        "aes-256-gcm",
        "chacha20-ietf-poly1305",
        "2022-blake3-aes-128-gcm",
        "2022-blake3-aes-256-gcm",
        "2022-blake3-chacha20-poly1305"
      ],
      "default": "aes-128-gcm",
      "ui_group": "core",
      "ui_order": 1,
      "title": {
        "en": "Cipher method",
        "ru": "Метод шифрования"
      },
      "description": {
        "en": "Shadowsocks method (sing-box shadowsocks.method).",
        "ru": "Метод Shadowsocks (shadowsocks.method)."
      }
    },
    "network": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "tcp",
        "udp",
        "tcp,udp"
      ],
      "default": "tcp",
      "ui_group": "core",
      "ui_order": 2,
      "title": {
        "en": "Network",
        "ru": "Сеть"
      },
      "description": {
        "en": "Listen/dial networks for the SS link.",
        "ru": "Сети listen/dial для SS."
      }
    },
    "udp_over_tcp": {
      "type": "bool",
      "widget": "toggle",
      "default": "false",
      "ui_group": "core",
      "ui_order": 3,
      "title": {
        "en": "UDP-over-TCP",
        "ru": "UDP-over-TCP"
      },
      "description": {
        "en": "Outbound udp_over_tcp v2 (when UDP path is filtered).",
        "ru": "Outbound udp_over_tcp v2 (если UDP режется)."
      }
    },
    "multiplex": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "none",
        "smux"
      ],
      "default": "none",
      "ui_group": "core",
      "ui_order": 4,
      "title": {
        "en": "Multiplex",
        "ru": "Multiplex"
      },
      "description": {
        "en": "Outbound smux multiplex (none disables).",
        "ru": "Outbound smux multiplex (none отключает)."
      }
    }
  },
  "inbound_template": {
    "type": "shadowsocks",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "method": "{{param.method}}",
    "password": "{{peer.password}}",
    "users": [],
    "network": "tcp"
  },
  "outbound_template": {
    "type": "shadowsocks",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "method": "{{param.method}}",
    "password": "{{user.password}}",
    "network": "tcp"
  }
}
