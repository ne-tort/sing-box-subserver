{
  "schema_version": 1,
  "tag": "vmess_custom",
  "protocol": "vmess",
  "aliases": [
    "vmess-custom",
    "vmess-constructor"
  ],
  "short_name": "VMess custom",
  "status": "lab",
  "custom_preset": true,
  "i18n": {
    "ru": {
      "title": "VMess конструктор",
      "description": "Лабораторный VMess: transport + TLS/Reality/plain, multiplex и WS early-data через params. Для новых Reality-стеков предпочтительнее VLESS."
    },
    "en": {
      "title": "VMess constructor",
      "description": "Lab VMess: transport, TLS mode, path/host/service_name, multiplex, WS early-data. Prefer VLESS for new Reality stacks."
    }
  },
  "traits": [
    "tcp",
    "udp",
    "tls",
    "custom"
  ],
  "demux_hints": {
    "network": [
      "tcp",
      "udp"
    ],
    "looks_like": "tls_clienthello",
    "alpn": [
      "h2",
      "http/1.1",
      "h3"
    ],
    "sni_required": true,
    "first_bytes": "Depends on transport/tls_mode",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 5,
    "speed": 6,
    "mobile": 5,
    "setup": 3
  },
  "cred_fields": [
    "uuid"
  ],
  "default_client_profiles": [
    "sec-auto"
  ],
  "param_fields": [
    "transport",
    "tls_mode"
  ],
  "optional_param_fields": [
    "packet_encoding",
    "fingerprint",
    "transport_path",
    "transport_host",
    "service_name",
    "alpn",
    "multiplex",
    "ws_max_early_data"
  ],
  "param_meta": {
    "transport": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "tcp",
        "ws",
        "grpc",
        "http",
        "httpupgrade",
        "quic"
      ],
      "default": "tcp",
      "ui_group": "transport",
      "ui_order": 1,
      "title": {
        "en": "Transport",
        "ru": "Транспорт"
      },
      "description": {
        "en": "VMess underlying transport (sing-box transport.type).",
        "ru": "Транспорт VMess (transport.type)."
      }
    },
    "tls_mode": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "none",
        "tls",
        "reality"
      ],
      "default": "tls",
      "ui_group": "tls",
      "ui_order": 2,
      "title": {
        "en": "TLS mode",
        "ru": "Режим TLS"
      },
      "description": {
        "en": "Plain TCP, TLS profile, or Reality assignment.",
        "ru": "Plain TCP, TLS-профиль CP или Reality."
      }
    },
    "packet_encoding": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "none",
        "xudp",
        "packetaddr"
      ],
      "default": "xudp",
      "ui_group": "core",
      "ui_order": 11,
      "title": {
        "en": "Packet encoding",
        "ru": "Packet encoding"
      },
      "description": {
        "en": "UDP/full-cone encoding (xudp recommended). none omits the field.",
        "ru": "Кодирование UDP (обычно xudp). none — поле не пишется."
      }
    },
    "fingerprint": {
      "type": "enum",
      "widget": "select",
      "default": "chrome",
      "ui_group": "tls",
      "ui_order": 20,
      "visible_when": [
        {
          "key": "tls_mode",
          "equals": "tls"
        }
      ],
      "title": {
        "en": "uTLS fingerprint",
        "ru": "uTLS fingerprint"
      },
      "description": {
        "en": "Client uTLS fingerprint (ignored for QUIC transport).",
        "ru": "uTLS fingerprint клиента (не для QUIC)."
      },
      "enum": [
        "chrome",
        "firefox",
        "safari",
        "edge",
        "ios",
        "android",
        "random"
      ]
    },
    "transport_path": {
      "type": "string",
      "widget": "path",
      "default": "/vmess",
      "ui_group": "transport",
      "ui_order": 30,
      "visible_when": [
        {
          "key": "transport",
          "in": [
            "ws",
            "http",
            "httpupgrade"
          ]
        }
      ],
      "title": {
        "en": "Path",
        "ru": "Path"
      },
      "description": {
        "en": "HTTP/WebSocket path after TLS.",
        "ru": "HTTP/WebSocket path после TLS."
      }
    },
    "transport_host": {
      "type": "string",
      "widget": "text",
      "ui_group": "transport",
      "ui_order": 31,
      "visible_when": [
        {
          "key": "transport",
          "in": [
            "ws",
            "http",
            "httpupgrade"
          ]
        }
      ],
      "title": {
        "en": "Host header",
        "ru": "Host header"
      },
      "description": {
        "en": "Host / :authority for WS/HTTP transports.",
        "ru": "Host / :authority для WS/HTTP."
      }
    },
    "service_name": {
      "type": "string",
      "widget": "text",
      "default": "VMessService",
      "ui_group": "transport",
      "ui_order": 32,
      "visible_when": [
        {
          "key": "transport",
          "equals": "grpc"
        }
      ],
      "title": {
        "en": "gRPC service name",
        "ru": "gRPC service name"
      },
      "description": {
        "en": "gRPC Gun service_name for vmess+grpc transport.",
        "ru": "gRPC Gun service_name для транспорта vmess+grpc."
      }
    },
    "alpn": {
      "type": "string",
      "widget": "text",
      "default": "h2,http/1.1",
      "ui_group": "tls",
      "ui_order": 21,
      "visible_when": [
        {
          "key": "tls_mode",
          "in": [
            "tls",
            "reality"
          ]
        }
      ],
      "title": {
        "en": "ALPN list",
        "ru": "Список ALPN"
      },
      "description": {
        "en": "Comma-separated ALPN (h3 for QUIC transport).",
        "ru": "ALPN через запятую (h3 для QUIC)."
      }
    },
    "multiplex": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "none",
        "smux"
      ],
      "default": "none",
      "ui_group": "core",
      "ui_order": 40,
      "visible_when": [
        {
          "key": "transport",
          "equals": "tcp"
        }
      ],
      "title": {
        "en": "Multiplex",
        "ru": "Multiplex"
      },
      "description": {
        "en": "smux+padding on TCP (inbound/outbound).",
        "ru": "smux+padding на TCP (inbound/outbound)."
      }
    },
    "ws_max_early_data": {
      "type": "uint16",
      "widget": "text",
      "default": "0",
      "ui_group": "transport",
      "ui_order": 33,
      "visible_when": [
        {
          "key": "transport",
          "equals": "ws"
        }
      ],
      "title": {
        "en": "WS max early data",
        "ru": "WS max early data"
      },
      "description": {
        "en": "0 disables; 2048 matches common CDN 0-RTT WS setups.",
        "ru": "0 отключает; 2048 — типичный CDN 0-RTT WS."
      }
    }
  },
  "requirements": {
    "tls_profile": true,
    "reality_assignment": true,
    "udp": true,
    "quic": true
  },
  "inbound_template": {
    "type": "vmess",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "users": [],
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ]
    },
    "transport": {
      "type": "{{param.transport}}",
      "path": "{{param.transport_path}}",
      "host": "{{param.transport_host}}",
      "service_name": "{{param.service_name}}",
      "headers": {
        "Host": [
          "{{param.transport_host}}"
        ]
      }
    }
  },
  "outbound_template": {
    "type": "vmess",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "uuid": "{{user.uuid}}",
    "security": "auto",
    "alter_id": 0,
    "packet_encoding": "{{param.packet_encoding}}",
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ],
      "utls": {
        "enabled": true,
        "fingerprint": "{{param.fingerprint}}"
      }
    },
    "transport": {
      "type": "{{param.transport}}",
      "path": "{{param.transport_path}}",
      "host": "{{param.transport_host}}",
      "service_name": "{{param.service_name}}",
      "headers": {
        "Host": [
          "{{param.transport_host}}"
        ]
      }
    }
  },
  "client_notes": {
    "security": "outbound profiles: sec-auto / sec-aes128 / sec-chacha / pkt-xudp",
    "constructor": "tls_mode=none strips tls; reality uses CP assignment; multiplex/ws_max_early_data via params"
  }
}
