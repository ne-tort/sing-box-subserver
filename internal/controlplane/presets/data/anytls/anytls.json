{
  "schema_version": 1,
  "tag": "anytls",
  "protocol": "anytls",
  "aliases": [
    "anytls"
  ],
  "short_name": "AnyTLS",
  "status": "stable",
  "i18n": {
    "ru": {
      "title": "AnyTLS",
      "description": "AnyTLS TCP+TLS с padding_scheme (DPI видит менее регулярные TLS record sizes)."
    },
    "en": {
      "title": "AnyTLS",
      "description": "AnyTLS TCP+TLS with padding_scheme (DPI sees less regular TLS record sizes)."
    }
  },
  "traits": [
    "tcp",
    "tls"
  ],
  "demux_hints": {
    "network": [
      "tcp"
    ],
    "looks_like": "tls_clienthello",
    "alpn": [],
    "sni_required": true,
    "first_bytes": "TLS ClientHello (password TLS wrapper)",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 6,
    "speed": 6,
    "mobile": 6,
    "setup": 6
  },
  "cred_fields": [
    "password"
  ],
  "inbound_template": {
    "type": "anytls",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "users": [],
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ]
    },
    "padding_scheme": [
      "stop=8",
      "0=30-30",
      "1=100-400",
      "2=400-500,c,500-1000,c,500-1000,c,500-1000,c,500-1000",
      "3=9-9,500-1000",
      "4=500-1000",
      "5=500-1000",
      "6=500-1000",
      "7=500-1000"
    ]
  },
  "outbound_template": {
    "type": "anytls",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "password": "{{user.password}}",
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ],
      "utls": {
        "enabled": true,
        "fingerprint": "chrome"
      }
    }
  },
  "requirements": {
    "tls_profile": true
  },
  "client_notes": {
    "padding_scheme": "inbound peer setting (DPI: irregular TLS record sizes)",
    "idle": "outbound idle_* — separate invariant anytls_idle"
  },
  "optional_param_fields": [
    "alpn",
    "fingerprint"
  ],
  "param_meta": {
    "alpn": {
      "type": "string",
      "widget": "text",
      "default": "h2,http/1.1",
      "ui_group": "tls",
      "ui_order": 20,
      "title": {
        "en": "ALPN",
        "ru": "ALPN"
      },
      "description": {
        "en": "Comma-separated TLS ALPN list.",
        "ru": "Список TLS ALPN через запятую."
      },
      "help": {
        "summary": {
          "en": "TLS ALPN offered on AnyTLS. Keep h2,http/1.1 unless the front requires a single ALPN.",
          "ru": "TLS ALPN на AnyTLS. Обычно h2,http/1.1, если front не требует один ALPN."
        },
        "input_hint": {
          "en": "h2,http/1.1 (CSV)",
          "ru": "h2,http/1.1 (CSV)"
        },
        "format": "h2,http/1.1"
      }
    },
    "fingerprint": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "chrome",
        "firefox",
        "safari",
        "edge",
        "ios",
        "android",
        "random"
      ],
      "default": "chrome",
      "ui_group": "tls",
      "ui_order": 21,
      "title": {
        "en": "uTLS fingerprint",
        "ru": "uTLS fingerprint"
      },
      "description": {
        "en": "Outbound uTLS ClientHello fingerprint.",
        "ru": "uTLS fingerprint ClientHello на outbound."
      },
      "help": {
        "summary": {
          "en": "Outbound uTLS fingerprint. Match a common browser unless you need a specific ClientHello class.",
          "ru": "uTLS fingerprint на outbound. Держите browser-like, если не нужен особый ClientHello."
        },
        "input_hint": {
          "en": "chrome|firefox|…",
          "ru": "chrome|firefox|…"
        },
        "format": "chrome"
      }
    }
  }
}
