{
  "schema_version": 1,
  "tag": "anytls",
  "singbox_type": "anytls",
  "short_name": "AnyTLS",
  "status": "stable",
  "i18n": {
    "ru": {
      "title": "AnyTLS",
      "description": "TLS-обёртка с парольной аутентификацией."
    },
    "en": {
      "title": "AnyTLS",
      "description": "TLS-обёртка с парольной аутентификацией."
    }
  },
  "default_cred_fields": [
    "password"
  ],
  "optional_param_fields": [
    "alpn",
    "fingerprint"
  ],
  "param_meta": {
    "alpn": {
      "type": "string",
      "widget": "text",
      "default": "h2,http/1.1",
      "ui_group": "tls",
      "ui_order": 20,
      "title": {
        "en": "ALPN",
        "ru": "ALPN"
      },
      "description": {
        "en": "Comma-separated TLS ALPN list.",
        "ru": "Список TLS ALPN через запятую."
      },
      "help": {
        "summary": {
          "en": "TLS ALPN offered on AnyTLS. Keep h2,http/1.1 unless the front requires a single ALPN.",
          "ru": "TLS ALPN на AnyTLS. Обычно h2,http/1.1, если front не требует один ALPN."
        },
        "input_hint": {
          "en": "h2,http/1.1 (CSV)",
          "ru": "h2,http/1.1 (CSV)"
        },
        "format": "h2,http/1.1"
      }
    },
    "fingerprint": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "chrome",
        "firefox",
        "safari",
        "edge",
        "ios",
        "android",
        "random"
      ],
      "default": "chrome",
      "ui_group": "tls",
      "ui_order": 21,
      "title": {
        "en": "uTLS fingerprint",
        "ru": "uTLS fingerprint"
      },
      "description": {
        "en": "Outbound uTLS ClientHello fingerprint.",
        "ru": "uTLS fingerprint ClientHello на outbound."
      },
      "help": {
        "summary": {
          "en": "Outbound uTLS fingerprint. Match a common browser unless you need a specific ClientHello class.",
          "ru": "uTLS fingerprint на outbound. Держите browser-like, если не нужен особый ClientHello."
        },
        "input_hint": {
          "en": "chrome|firefox|…",
          "ru": "chrome|firefox|…"
        },
        "format": "chrome"
      }
    }
  }
}
