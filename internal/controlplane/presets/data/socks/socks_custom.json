{
  "schema_version": 1,
  "tag": "socks_custom",
  "protocol": "socks",
  "aliases": ["socks-custom", "socks-constructor"],
  "short_name": "SOCKS custom",
  "status": "lab",
  "custom_preset": true,
  "i18n": {
    "ru": {
      "title": "SOCKS конструктор",
      "description": "SOCKS5 auth; опционально UDP-over-TCP на outbound."
    },
    "en": {
      "title": "SOCKS constructor",
      "description": "SOCKS5 auth; optional UDP-over-TCP on outbound."
    }
  },
  "traits": ["tcp", "custom"],
  "demux_hints": {
    "network": ["tcp"],
    "looks_like": "raw_tcp",
    "alpn": [],
    "sni_required": false,
    "first_bytes": "SOCKS greeting",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 1,
    "speed": 8,
    "mobile": 7,
    "setup": 3
  },
  "cred_fields": ["username", "password"],
  "optional_param_fields": ["udp_over_tcp"],
  "param_meta": {
    "udp_over_tcp": {
      "type": "bool",
      "widget": "toggle",
      "default": "false",
      "ui_group": "core",
      "ui_order": 1,
      "title": {"en": "UDP-over-TCP", "ru": "UDP-over-TCP"},
      "description": {
        "en": "Outbound udp_over_tcp v2 when UDP associate is blocked.",
        "ru": "Outbound udp_over_tcp v2, если UDP associate режется."
      }
    }
  },
  "inbound_template": {
    "type": "socks",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "users": []
  },
  "outbound_template": {
    "type": "socks",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "username": "{{user.username}}",
    "password": "{{user.password}}"
  }
}
