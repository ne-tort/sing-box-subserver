{
  "schema_version": 1,
  "tag": "tuic_custom",
  "protocol": "tuic",
  "aliases": [
    "tuic-custom"
  ],
  "short_name": "TUIC custom",
  "status": "lab",
  "i18n": {
    "ru": {
      "title": "TUIC custom (конструктор)",
      "description": "Лабораторный TUIC: congestion, udp_relay_mode, опциональный 0-RTT."
    },
    "en": {
      "title": "TUIC constructor",
      "description": "Lab TUIC: tune congestion control, UDP relay mode, and optional 0-RTT handshake."
    }
  },
  "traits": [
    "udp",
    "quic",
    "tls",
    "custom"
  ],
  "demux_hints": {
    "network": [
      "udp"
    ],
    "looks_like": "quic",
    "alpn": [],
    "sni_required": true,
    "first_bytes": "QUIC ClientHello (TUIC v5; congestion/0-RTT vary)",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 7,
    "speed": 8,
    "mobile": 5,
    "setup": 3
  },
  "cred_fields": [
    "uuid",
    "password"
  ],
  "optional_param_fields": [
    "congestion_control",
    "udp_relay_mode",
    "zero_rtt"
  ],
  "param_meta": {
    "congestion_control": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "cubic",
        "bbr",
        "new_reno"
      ],
      "default": "bbr",
      "ui_group": "core",
      "ui_order": 1,
      "title": {
        "en": "Congestion control",
        "ru": "Congestion control"
      },
      "description": {
        "en": "QUIC congestion algorithm (sing-box tuic.congestion_control).",
        "ru": "Алгоритм congestion QUIC (tuic.congestion_control)."
      }
    },
    "udp_relay_mode": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "native",
        "quic"
      ],
      "default": "native",
      "ui_group": "core",
      "ui_order": 2,
      "title": {
        "en": "UDP relay mode",
        "ru": "UDP relay mode"
      },
      "description": {
        "en": "Outbound udp_relay_mode: native full-cone vs QUIC-encapsulated relay.",
        "ru": "Outbound udp_relay_mode: native или relay через QUIC."
      }
    },
    "zero_rtt": {
      "type": "bool",
      "widget": "toggle",
      "default": "false",
      "ui_group": "core",
      "ui_order": 3,
      "title": {
        "en": "0-RTT handshake",
        "ru": "0-RTT handshake"
      },
      "description": {
        "en": "Enable zero_rtt_handshake (faster resume; weaker replay resistance).",
        "ru": "Включить zero_rtt_handshake (быстрее resume; слабее replay resistance)."
      }
    }
  },
  "inbound_template": {
    "type": "tuic",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "users": [],
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h3"
      ]
    },
    "congestion_control": "{{param.congestion_control}}",
    "auth_timeout": "3s",
    "heartbeat": "10s"
  },
  "outbound_template": {
    "type": "tuic",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "uuid": "{{user.uuid}}",
    "password": "{{user.password}}",
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h3"
      ]
    },
    "congestion_control": "{{param.congestion_control}}",
    "udp_relay_mode": "{{param.udp_relay_mode}}",
    "heartbeat": "10s"
  },
  "requirements": {
    "tls_profile": true,
    "udp": true,
    "quic": true
  },
  "client_notes": {
    "udp_relay_mode": "outbound-only: native|quic",
    "zero_rtt": "binding param zero_rtt=true sets zero_rtt_handshake on inbound/outbound"
  },
  "default_client_profiles": [
    "udp-native"
  ],
  "custom_preset": true
}
