{
  "schema_version": 1,
  "tag": "vless_tls_mux",
  "protocol": "vless",
  "aliases": [
    "vless-tls-mux"
  ],
  "short_name": "VLESS mux",
  "status": "stable",
  "i18n": {
    "ru": {
      "title": "VLESS TLS + multiplex",
      "description": "VLESS+TLS с multiplex (smux+padding) — меньше TCP handshake, другой pattern для DPI."
    }
  },
  "traits": [
    "tcp",
    "tls",
    "multiplex"
  ],
  "demux_hints": {
    "network": [
      "tcp"
    ],
    "looks_like": "tls_clienthello",
    "alpn": [],
    "sni_required": true,
    "first_bytes": "TLS ClientHello → VLESS+mux",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 6,
    "speed": 8,
    "mobile": 7,
    "setup": 6
  },
  "cred_fields": [
    "uuid",
    "uuid_xtls",
    "uuid_udp"
  ],
  "default_client_profiles": [
    "pkt-xudp"
  ],
  "inbound_template": {
    "type": "vless",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "users": [],
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ]
    },
    "multiplex": {
      "enabled": true,
      "padding": true
    }
  },
  "outbound_template": {
    "type": "vless",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "uuid": "{{user.uuid}}",
    "packet_encoding": "xudp",
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ],
      "utls": {
        "enabled": true,
        "fingerprint": "chrome"
      }
    },
    "multiplex": {
      "enabled": true,
      "protocol": "smux",
      "padding": true,
      "max_connections": 4,
      "min_streams": 4,
      "max_streams": 16
    }
  },
  "requirements": {
    "tls_profile": true
  },
  "client_notes": {
    "flow": "Vision + mux are usually incompatible — catalog keeps full set; operator may narrow enabled_user_variants"
  },
  "optional_param_fields": [
    "fingerprint"
  ],
  "param_meta": {
    "fingerprint": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "chrome",
        "firefox",
        "safari",
        "edge",
        "ios",
        "android",
        "random"
      ],
      "default": "chrome",
      "ui_group": "tls",
      "ui_order": 90,
      "title": {
        "en": "uTLS fingerprint",
        "ru": "uTLS fingerprint"
      },
      "description": {
        "en": "Outbound uTLS ClientHello fingerprint.",
        "ru": "uTLS fingerprint ClientHello на outbound."
      },
      "help": {
        "summary": {
          "en": "Outbound uTLS fingerprint. Override the template default (usually chrome).",
          "ru": "uTLS fingerprint на outbound. Переопределяет default шаблона (обычно chrome)."
        },
        "input_hint": {
          "en": "chrome|firefox|…",
          "ru": "chrome|firefox|…"
        },
        "format": "chrome"
      }
    }
  }
}
