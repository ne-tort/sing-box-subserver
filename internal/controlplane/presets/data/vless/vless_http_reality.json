{
  "schema_version": 1,
  "tag": "vless_http_reality",
  "protocol": "vless",
  "aliases": [
    "vless-http-reality"
  ],
  "short_name": "VLESS HTTP+R",
  "status": "stable",
  "i18n": {
    "ru": {
      "title": "VLESS HTTP+R",
      "description": "vless + Reality + HTTP/2 transport."
    }
  },
  "traits": [
    "tcp",
    "tls",
    "http",
    "reality"
  ],
  "demux_hints": {
    "network": [
      "tcp"
    ],
    "looks_like": "tls_clienthello",
    "alpn": [
      "h2",
      "http/1.1"
    ],
    "sni_required": true,
    "first_bytes": "Reality TLS then HTTP/2",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 9,
    "speed": 6,
    "mobile": 5,
    "setup": 5
  },
  "cred_fields": [
    "uuid"
  ],
  "inbound_template": {
    "type": "vless",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "users": [],
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ]
    },
    "transport": {
      "type": "http",
      "host": [
        "{{param.http_host}}"
      ],
      "path": "{{param.http_path}}",
      "method": "PUT",
      "headers": {
        "User-Agent": [
          "Mozilla/5.0"
        ],
        "Accept-Language": [
          "en-US,en;q=0.9"
        ]
      },
      "idle_timeout": "15s",
      "ping_timeout": "15s"
    }
  },
  "outbound_template": {
    "type": "vless",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ],
      "utls": {
        "enabled": true,
        "fingerprint": "chrome"
      }
    },
    "transport": {
      "type": "http",
      "host": [
        "{{param.http_host}}"
      ],
      "path": "{{param.http_path}}",
      "method": "PUT",
      "headers": {
        "User-Agent": [
          "Mozilla/5.0"
        ],
        "Accept-Language": [
          "en-US,en;q=0.9"
        ]
      },
      "idle_timeout": "15s",
      "ping_timeout": "15s"
    },
    "uuid": "{{user.uuid}}",
    "packet_encoding": "xudp"
  },
  "requirements": {
    "tls_profile": true,
    "reality_assignment": true
  },
  "default_user_variants": [
    "flow-none"
  ],
  "default_client_profiles": [
    "pkt-xudp"
  ],
  "client_notes": {
    "params": "optional bindings[].params overrides: http_host, http_path",
    "http_path_default": "/vless-h2"
  },
  "optional_param_fields": [
    "http_path",
    "http_host",
    "fingerprint"
  ],
  "param_meta": {
    "http_path": {
      "type": "string",
      "widget": "path",
      "default": "/",
      "ui_group": "transport",
      "ui_order": 30,
      "title": {
        "en": "HTTP path",
        "ru": "HTTP path"
      },
      "description": {
        "en": "HTTP path for VLESS HTTP transport.",
        "ru": "HTTP path для VLESS HTTP."
      }
    },
    "http_host": {
      "type": "string",
      "widget": "text",
      "ui_group": "transport",
      "ui_order": 31,
      "title": {
        "en": "HTTP Host",
        "ru": "HTTP Host"
      },
      "description": {
        "en": "Host header for HTTP transport.",
        "ru": "Host header для HTTP."
      }
    },
    "fingerprint": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "chrome",
        "firefox",
        "safari",
        "edge",
        "ios",
        "android",
        "random"
      ],
      "default": "chrome",
      "ui_group": "tls",
      "ui_order": 90,
      "title": {
        "en": "uTLS fingerprint",
        "ru": "uTLS fingerprint"
      },
      "description": {
        "en": "Outbound uTLS ClientHello fingerprint.",
        "ru": "uTLS fingerprint ClientHello на outbound."
      },
      "help": {
        "summary": {
          "en": "Outbound uTLS fingerprint. Override the template default (usually chrome).",
          "ru": "uTLS fingerprint на outbound. Переопределяет default шаблона (обычно chrome)."
        },
        "input_hint": {
          "en": "chrome|firefox|…",
          "ru": "chrome|firefox|…"
        },
        "format": "chrome"
      }
    }
  }
}
