{
  "schema_version": 1,
  "tag": "vless_ws_reality",
  "protocol": "vless",
  "aliases": [
    "vless-ws-reality"
  ],
  "short_name": "VLESS WS+R",
  "status": "stable",
  "i18n": {
    "ru": {
      "title": "VLESS WS Reality",
      "description": "VLESS + Reality + WebSocket (TLS fingerprint Reality, поверх — WS path)."
    }
  },
  "traits": [
    "tcp",
    "tls",
    "ws",
    "reality"
  ],
  "demux_hints": {
    "network": [
      "tcp"
    ],
    "looks_like": "tls_clienthello",
    "alpn": [],
    "sni_required": true,
    "first_bytes": "Reality TLS then WS",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 9,
    "speed": 6,
    "mobile": 6,
    "setup": 6
  },
  "cred_fields": [
    "uuid"
  ],
  "default_user_variants": [
    "flow-none"
  ],
  "default_client_profiles": [
    "pkt-xudp"
  ],
  "inbound_template": {
    "type": "vless",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "users": [],
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ]
    },
    "transport": {
      "type": "ws",
      "path": "{{param.ws_path}}",
      "headers": {
        "Host": [
          "{{param.ws_host}}"
        ],
        "User-Agent": [
          "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
        ]
      }
    }
  },
  "outbound_template": {
    "type": "vless",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "uuid": "{{user.uuid}}",
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ],
      "utls": {
        "enabled": true,
        "fingerprint": "chrome"
      }
    },
    "transport": {
      "type": "ws",
      "path": "{{param.ws_path}}",
      "headers": {
        "Host": [
          "{{param.ws_host}}"
        ],
        "User-Agent": [
          "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
        ]
      }
    },
    "packet_encoding": "xudp"
  },
  "requirements": {
    "tls_profile": true,
    "reality_assignment": true
  },
  "client_notes": {
    "flow": "Vision/XTLS несовместим с WS/gRPC/HTTP/HTTPUpgrade — только flow-none",
    "packet_encoding": "по умолчанию xudp; профили pkt-none / pkt-packetaddr через enabled_client_profiles",
    "params": "optional bindings[].params overrides: ws_host, ws_path",
    "ws_path_default": "/ray",
    "early_data": "disabled by default for Reality WS (enable via template fork if needed)"
  },
  "optional_param_fields": [
    "ws_path",
    "ws_host"
  ],
  "param_meta": {
    "ws_path": {
      "type": "string",
      "widget": "path",
      "default": "/vless-ws",
      "ui_group": "transport",
      "ui_order": 30,
      "title": {
        "en": "WebSocket path",
        "ru": "WebSocket path"
      },
      "description": {
        "en": "HTTP path for VLESS WebSocket.",
        "ru": "HTTP path для VLESS WebSocket."
      }
    },
    "ws_host": {
      "type": "string",
      "widget": "text",
      "ui_group": "transport",
      "ui_order": 31,
      "title": {
        "en": "WebSocket Host",
        "ru": "WebSocket Host"
      },
      "description": {
        "en": "Host header for WebSocket (defaults to server name).",
        "ru": "Host header для WebSocket (по умолчанию server)."
      }
    }
  }
}
