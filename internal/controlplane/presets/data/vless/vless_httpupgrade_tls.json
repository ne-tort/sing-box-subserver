{
  "schema_version": 1,
  "tag": "vless_httpupgrade_tls",
  "protocol": "vless",
  "aliases": [
    "vless-httpupgrade-tls"
  ],
  "short_name": "VLESS HUp",
  "status": "stable",
  "i18n": {
    "ru": {
      "title": "VLESS HTTPUpgrade TLS",
      "description": "VLESS + TLS + HTTPUpgrade (один HTTP Upgrade, без WS framing)."
    }
  },
  "traits": [
    "tcp",
    "tls",
    "httpupgrade"
  ],
  "demux_hints": {
    "network": [
      "tcp"
    ],
    "looks_like": "tls_clienthello",
    "alpn": [],
    "sni_required": true,
    "first_bytes": "TLS then HTTP Upgrade",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 7,
    "speed": 6,
    "mobile": 6,
    "setup": 6
  },
  "cred_fields": [
    "uuid"
  ],
  "default_user_variants": [
    "flow-none"
  ],
  "default_client_profiles": [
    "pkt-xudp"
  ],
  "inbound_template": {
    "type": "vless",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "users": [],
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ]
    },
    "transport": {
      "type": "httpupgrade",
      "path": "{{param.hu_path}}",
      "host": "{{param.hu_host}}",
      "headers": {
        "User-Agent": [
          "Mozilla/5.0"
        ]
      }
    }
  },
  "outbound_template": {
    "type": "vless",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "uuid": "{{user.uuid}}",
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ],
      "utls": {
        "enabled": true,
        "fingerprint": "chrome"
      }
    },
    "transport": {
      "type": "httpupgrade",
      "path": "{{param.hu_path}}",
      "host": "{{param.hu_host}}",
      "headers": {
        "User-Agent": [
          "Mozilla/5.0"
        ]
      }
    },
    "packet_encoding": "xudp"
  },
  "requirements": {
    "tls_profile": true
  },
  "client_notes": {
    "flow": "Vision/XTLS is incompatible with WS/gRPC/HTTP/HTTPUpgrade — use flow-none only",
    "packet_encoding": "default xudp; profiles pkt-none / pkt-packetaddr via enabled_client_profiles",
    "params": "optional bindings[].params overrides: hu_host, hu_path",
    "hu_path_default": "/vless-hu"
  },
  "optional_param_fields": [
    "hu_path",
    "hu_host",
    "fingerprint"
  ],
  "param_meta": {
    "hu_path": {
      "type": "string",
      "widget": "path",
      "default": "/",
      "ui_group": "transport",
      "ui_order": 30,
      "title": {
        "en": "HTTPUpgrade path",
        "ru": "HTTPUpgrade path"
      },
      "description": {
        "en": "Path for HTTPUpgrade transport.",
        "ru": "Path для HTTPUpgrade."
      }
    },
    "hu_host": {
      "type": "string",
      "widget": "text",
      "ui_group": "transport",
      "ui_order": 31,
      "title": {
        "en": "HTTPUpgrade host",
        "ru": "HTTPUpgrade host"
      },
      "description": {
        "en": "Host for HTTPUpgrade transport.",
        "ru": "Host для HTTPUpgrade."
      }
    },
    "fingerprint": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "chrome",
        "firefox",
        "safari",
        "edge",
        "ios",
        "android",
        "random"
      ],
      "default": "chrome",
      "ui_group": "tls",
      "ui_order": 90,
      "title": {
        "en": "uTLS fingerprint",
        "ru": "uTLS fingerprint"
      },
      "description": {
        "en": "Outbound uTLS ClientHello fingerprint.",
        "ru": "uTLS fingerprint ClientHello на outbound."
      },
      "help": {
        "summary": {
          "en": "Outbound uTLS fingerprint. Override the template default (usually chrome).",
          "ru": "uTLS fingerprint на outbound. Переопределяет default шаблона (обычно chrome)."
        },
        "input_hint": {
          "en": "chrome|firefox|…",
          "ru": "chrome|firefox|…"
        },
        "format": "chrome"
      }
    }
  }
}
