{
  "schema_version": 1,
  "tag": "vless_grpc_tls",
  "protocol": "vless",
  "aliases": [
    "vless-grpc-tls"
  ],
  "short_name": "VLESS gRPC",
  "status": "stable",
  "i18n": {
    "ru": {
      "title": "VLESS gRPC TLS",
      "description": "VLESS + TLS + gRPC (HTTP/2, service_name)."
    }
  },
  "traits": [
    "tcp",
    "tls",
    "grpc"
  ],
  "demux_hints": {
    "network": [
      "tcp"
    ],
    "looks_like": "tls_clienthello",
    "alpn": [],
    "sni_required": true,
    "first_bytes": "TLS then h2 gRPC",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 7,
    "speed": 6,
    "mobile": 6,
    "setup": 6
  },
  "cred_fields": [
    "uuid"
  ],
  "default_user_variants": [
    "flow-none"
  ],
  "default_client_profiles": [
    "pkt-xudp"
  ],
  "inbound_template": {
    "type": "vless",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "users": [],
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2"
      ]
    },
    "transport": {
      "type": "grpc",
      "service_name": "{{param.service_name}}",
      "idle_timeout": "15s",
      "ping_timeout": "15s",
      "permit_without_stream": false
    }
  },
  "outbound_template": {
    "type": "vless",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "uuid": "{{user.uuid}}",
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2"
      ],
      "utls": {
        "enabled": true,
        "fingerprint": "chrome"
      }
    },
    "transport": {
      "type": "grpc",
      "service_name": "{{param.service_name}}",
      "idle_timeout": "15s",
      "ping_timeout": "15s",
      "permit_without_stream": false
    },
    "packet_encoding": "xudp"
  },
  "requirements": {
    "tls_profile": true
  },
  "client_notes": {
    "flow": "Vision/XTLS несовместим с WS/gRPC/HTTP/HTTPUpgrade — только flow-none",
    "packet_encoding": "по умолчанию xudp; профили pkt-none / pkt-packetaddr через enabled_client_profiles"
  },
  "optional_param_fields": [
    "service_name"
  ],
  "param_meta": {
    "service_name": {
      "type": "string",
      "widget": "text",
      "default": "GunService",
      "ui_group": "transport",
      "ui_order": 36,
      "title": {
        "en": "gRPC service name",
        "ru": "gRPC service name"
      },
      "description": {
        "en": "gRPC Gun service_name (post-TLS H2 marker).",
        "ru": "gRPC Gun service_name (маркер после TLS/H2)."
      }
    }
  }
}
