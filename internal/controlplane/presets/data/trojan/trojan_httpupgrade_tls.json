{
  "schema_version": 1,
  "tag": "trojan_httpupgrade_tls",
  "protocol": "trojan",
  "aliases": [
    "trojan-httpupgrade-tls"
  ],
  "short_name": "Trojan HUp",
  "status": "stable",
  "i18n": {
    "ru": {
      "title": "Trojan HTTPUpgrade TLS",
      "description": "Trojan + TLS + HTTPUpgrade."
    }
  },
  "traits": [
    "tcp",
    "tls",
    "httpupgrade"
  ],
  "demux_hints": {
    "network": [
      "tcp"
    ],
    "looks_like": "tls_clienthello",
    "alpn": [],
    "sni_required": true,
    "first_bytes": "TLS then httpupgrade",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 7,
    "speed": 6,
    "mobile": 6,
    "setup": 6
  },
  "cred_fields": [
    "password"
  ],
  "inbound_template": {
    "type": "trojan",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "users": [],
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ]
    },
    "transport": {
      "type": "httpupgrade",
      "path": "{{param.hu_path}}",
      "host": "{{param.hu_host}}",
      "headers": {
        "User-Agent": [
          "Mozilla/5.0"
        ]
      }
    }
  },
  "outbound_template": {
    "type": "trojan",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "password": "{{user.password}}",
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ],
      "utls": {
        "enabled": true,
        "fingerprint": "chrome"
      }
    },
    "transport": {
      "type": "httpupgrade",
      "path": "{{param.hu_path}}",
      "host": "{{param.hu_host}}",
      "headers": {
        "User-Agent": [
          "Mozilla/5.0"
        ]
      }
    }
  },
  "requirements": {
    "tls_profile": true
  },
  "client_notes": {
    "params": "optional bindings[].params overrides: hu_host, hu_path",
    "hu_path_default": "/trojan-hu"
  },
  "optional_param_fields": [
    "hu_host",
    "hu_path",
    "fingerprint"
  ],
  "param_meta": {
    "hu_host": {
      "type": "string",
      "widget": "text",
      "ui_group": "transport",
      "ui_order": 35,
      "title": {
        "en": "HTTPUpgrade Host",
        "ru": "HTTPUpgrade Host"
      },
      "description": {
        "en": "Host for HTTPUpgrade.",
        "ru": "Host для HTTPUpgrade."
      }
    },
    "hu_path": {
      "type": "string",
      "widget": "path",
      "default": "/trojan-hu",
      "ui_group": "transport",
      "ui_order": 34,
      "title": {
        "en": "HTTPUpgrade path",
        "ru": "HTTPUpgrade path"
      },
      "description": {
        "en": "Single HTTP Upgrade path (no WS framing).",
        "ru": "Path одного HTTP Upgrade (без WS framing)."
      }
    },
    "fingerprint": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "chrome",
        "firefox",
        "safari",
        "edge",
        "ios",
        "android",
        "random"
      ],
      "default": "chrome",
      "ui_group": "tls",
      "ui_order": 90,
      "title": {
        "en": "uTLS fingerprint",
        "ru": "uTLS fingerprint"
      },
      "description": {
        "en": "Outbound uTLS ClientHello fingerprint.",
        "ru": "uTLS fingerprint ClientHello на outbound."
      },
      "help": {
        "summary": {
          "en": "Outbound uTLS fingerprint. Override the template default (usually chrome).",
          "ru": "uTLS fingerprint на outbound. Переопределяет default шаблона (обычно chrome)."
        },
        "input_hint": {
          "en": "chrome|firefox|…",
          "ru": "chrome|firefox|…"
        },
        "format": "chrome"
      }
    }
  }
}
