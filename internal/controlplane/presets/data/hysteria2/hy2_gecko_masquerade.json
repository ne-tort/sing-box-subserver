{
  "schema_version": 1,
  "tag": "hy2_gecko_masquerade",
  "protocol": "hysteria2",
  "aliases": [
    "hysteria2-gecko-masquerade"
  ],
  "short_name": "Hy2 geckoM",
  "status": "lab",
  "i18n": {
    "ru": {
      "title": "Hysteria2 Gecko + Masquerade",
      "description": "Hy2 gecko obfs + inbound masquerade.type=string (HTTP decoy на fail auth)."
    }
  },
  "traits": [
    "udp",
    "quic",
    "tls",
    "obfs",
    "gecko",
    "masquerade"
  ],
  "demux_hints": {
    "network": [
      "udp"
    ],
    "looks_like": "quic",
    "alpn": [
      "h3"
    ],
    "sni_required": true,
    "first_bytes": "gecko-obfuscated QUIC",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 9,
    "speed": 7,
    "mobile": 4,
    "setup": 3
  },
  "cred_fields": [
    "password"
  ],
  "peer_secret_fields": {
    "obfs_password": "password"
  },
  "inbound_template": {
    "type": "hysteria2",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "users": [],
    "ignore_client_bandwidth": true,
    "up_mbps": 100,
    "down_mbps": 100,
    "obfs": {
      "type": "gecko",
      "password": "{{peer.obfs_password}}",
      "min_packet_size": 512,
      "max_packet_size": 1200
    },
    "masquerade": {
      "type": "string",
      "status_code": 200,
      "content": "<html><title>OK</title></html>",
      "headers": {
        "Content-Type": [
          "text/html; charset=utf-8"
        ]
      }
    },
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h3"
      ]
    }
  },
  "outbound_template": {
    "type": "hysteria2",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "password": "{{user.password}}",
    "up_mbps": 100,
    "down_mbps": 100,
    "obfs": {
      "type": "gecko",
      "password": "{{peer.obfs_password}}",
      "min_packet_size": 512,
      "max_packet_size": 1200
    },
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h3"
      ]
    }
  },
  "requirements": {
    "tls_profile": true,
    "udp": true,
    "quic": true
  },
  "client_notes": {
    "masquerade": "inbound-only",
    "obfs": "peer_symmetric gecko"
  }
}
