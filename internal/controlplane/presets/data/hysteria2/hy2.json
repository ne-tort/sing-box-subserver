    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "password": "{{user.password}}",
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h3"
      ]
    },
    "up_mbps": 100,
    "down_mbps": 100
  },
  "requirements": {
    "tls_profile": true,
    "udp": true,
