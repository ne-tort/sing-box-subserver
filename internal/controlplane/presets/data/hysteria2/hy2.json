      "ui_group": "core",
      "ui_order": 10,
      "title": {
        "en": "Upload Mbps",
        "ru": "Upload Mbps"
      },
      "description": {
        "en": "Hy2 upload cap.",
        "ru": "Лимит upload Hy2."
      },
      "help": {
        "input_hint": {
          "en": "1–65535 Mbps",
          "ru": "1–65535 Mbps"
        }
      }
    },
    "down_mbps": {
      "type": "uint16",
      "widget": "text",
      "default": "100",
      "ui_group": "core",
      "ui_order": 11,
      "title": {
        "en": "Download Mbps",
        "ru": "Download Mbps"
      },
      "description": {
        "en": "Hy2 download cap.",
        "ru": "Лимит download Hy2."
      },
      "help": {
        "input_hint": {
          "en": "1–65535 Mbps",
          "ru": "1–65535 Mbps"
        }
      }
    },
