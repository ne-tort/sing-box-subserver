{
  "schema_version": 1,
  "tag": "hy2_masquerade",
  "protocol": "hysteria2",
  "aliases": [
    "hysteria2-masquerade"
  ],
  "short_name": "Hy2 mask",
  "status": "stable",
  "i18n": {
    "ru": {
      "title": "Hysteria2 Masquerade",
      "description": "Hy2 + TLS + HTTP masquerade (ответы на невалидный auth выглядят как обычный сайт)."
    }
  },
  "traits": [
    "udp",
    "quic",
    "tls",
    "masquerade"
  ],
  "demux_hints": {
    "network": [
      "udp"
    ],
    "looks_like": "quic",
    "alpn": [
      "h3"
    ],
    "sni_required": true,
    "first_bytes": "QUIC/H3 masquerade",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 8,
    "speed": 9,
    "mobile": 5,
    "setup": 5
  },
  "cred_fields": [
    "password"
  ],
  "inbound_template": {
    "type": "hysteria2",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "users": [],
    "masquerade": {
      "type": "string",
      "status_code": 200,
      "headers": {
        "Content-Type": [
          "text/html; charset=utf-8"
        ],
        "Server": [
          "nginx"
        ]
      },
      "content": "<!DOCTYPE html><html><head><title>Welcome</title></head><body><h1>It works!</h1></body></html>"
    },
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h3"
      ]
    },
    "ignore_client_bandwidth": true
  },
  "outbound_template": {
    "type": "hysteria2",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "password": "{{user.password}}",
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h3"
      ]
    }
  },
  "requirements": {
    "tls_profile": true,
    "udp": true,
    "quic": true
  },
  "client_notes": {
    "masquerade": "inbound-only: клиенту не нужен; DPI/пробы видят HTML ответ"
  },
  "optional_param_fields": [
    "up_mbps",
    "down_mbps",
    "ignore_client_bandwidth"
  ],
  "param_meta": {
    "up_mbps": {
      "type": "uint16",
      "widget": "text",
      "default": "100",
      "ui_group": "core",
      "ui_order": 10,
      "title": {
        "en": "Upload Mbps",
        "ru": "Upload Mbps"
      },
      "description": {
        "en": "Hy2 upload cap.",
        "ru": "Лимит upload Hy2."
      },
      "help": {
        "input_hint": {
          "en": "1–65535 Mbps",
          "ru": "1–65535 Mbps"
        }
      }
    },
    "down_mbps": {
      "type": "uint16",
      "widget": "text",
      "default": "100",
      "ui_group": "core",
      "ui_order": 11,
      "title": {
        "en": "Download Mbps",
        "ru": "Download Mbps"
      },
      "description": {
        "en": "Hy2 download cap.",
        "ru": "Лимит download Hy2."
      },
      "help": {
        "input_hint": {
          "en": "1–65535 Mbps",
          "ru": "1–65535 Mbps"
        }
      }
    },
    "ignore_client_bandwidth": {
      "type": "bool",
      "widget": "toggle",
      "default": "true",
      "ui_group": "core",
      "ui_order": 15,
      "title": {
        "en": "Ignore client bandwidth",
        "ru": "Ignore client bandwidth"
      },
      "description": {
        "en": "Ignore client-advertised up/down Mbps; use server caps only.",
        "ru": "Игнорировать up/down Mbps клиента; брать только серверные caps."
      },
      "help": {
        "summary": {
          "en": "When true, Hy2 ignores client bandwidth advertisements and uses server up/down caps.",
          "ru": "При true Hy2 игнорирует bandwidth клиента и использует серверные up/down caps."
        },
        "input_hint": {
          "en": "true|false",
          "ru": "true|false"
        },
        "format": "false"
      }
    }
  }
}
