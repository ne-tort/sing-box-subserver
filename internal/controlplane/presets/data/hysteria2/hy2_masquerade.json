{
  "schema_version": 1,
  "tag": "hy2_masquerade",
  "protocol": "hysteria2",
  "aliases": [
    "hysteria2-masquerade"
  ],
  "short_name": "Hy2 mask",
  "status": "stable",
  "i18n": {
    "ru": {
      "title": "Hysteria2 Masquerade",
      "description": "Hy2 + TLS + HTTP masquerade (ответы на невалидный auth выглядят как обычный сайт)."
    }
  },
  "traits": [
    "udp",
    "quic",
    "tls",
    "masquerade"
  ],
  "demux_hints": {
    "network": [
      "udp"
    ],
    "looks_like": "quic",
    "alpn": [
      "h3"
    ],
    "sni_required": true,
    "first_bytes": "QUIC/H3 masquerade",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 8,
    "speed": 9,
    "mobile": 5,
    "setup": 5
  },
  "cred_fields": [
    "password"
  ],
  "inbound_template": {
    "type": "hysteria2",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "users": [],
    "masquerade": {
      "type": "string",
      "status_code": 200,
      "headers": {
        "Content-Type": [
          "text/html; charset=utf-8"
        ],
        "Server": [
          "nginx"
        ]
      },
      "content": "<!DOCTYPE html><html><head><title>Welcome</title></head><body><h1>It works!</h1></body></html>"
    },
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h3"
      ]
    },
    "ignore_client_bandwidth": true
  },
  "outbound_template": {
    "type": "hysteria2",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "password": "{{user.password}}",
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h3"
      ]
    }
  },
  "requirements": {
    "tls_profile": true,
    "udp": true,
    "quic": true
  },
  "client_notes": {
    "masquerade": "inbound-only: клиенту не нужен; DPI/пробы видят HTML ответ"
  }
}
