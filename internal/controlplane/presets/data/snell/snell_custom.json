      "title": {
        "en": "Obfs Host",
        "ru": "Obfs Host"
      },
      "description": {
        "en": "Host header for HTTP/TLS obfs.",
        "ru": "Host header для HTTP/TLS obfs."
      },
      "visible_when": [
