{
  "schema_version": 1,
  "tag": "shadowquic_custom",
  "protocol": "shadowquic",
  "aliases": [
    "shadowquic-custom"
  ],
  "short_name": "SQ 0-RTT custom",
  "status": "lab",
  "i18n": {
    "ru": {
      "title": "SQ 0-RTT custom (конструктор)",
      "description": "Минимальный лабораторный конструктор на базе shadowquic_0rtt.json."
    },
    "en": {
      "title": "ShadowQUIC constructor",
      "description": "Lab ShadowQUIC with JLS knobs. Prefer shadowquic_jls for demux QUIC substitutes."
    }
  },
  "traits": [
    "udp",
    "quic",
    "jls",
    "0rtt",
    "custom"
  ],
  "demux_hints": {
    "network": [
      "udp"
    ],
    "looks_like": "quic",
    "alpn": [
      "h3"
    ],
    "sni_required": true,
    "first_bytes": "QUIC 0-RTT",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 8,
    "speed": 9,
    "mobile": 5,
    "setup": 3
  },
  "cred_fields": [
    "username",
    "password"
  ],
  "inbound_template": {
    "type": "shadowquic",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "users": [],
    "jls_upstream": {
      "addr": "{{param.jls_addr}}",
      "server_name": "{{param.jls_server_name}}"
    },
    "alpn": [
      "h3"
    ],
    "congestion_control": "bbr",
    "idle_timeout": "30s",
    "zero_rtt": true,
    "recv_window_conn": 15728640,
    "recv_window": 67108864,
    "max_datagram_frame_size": 1200
  },
  "outbound_template": {
    "type": "shadowquic",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "username": "{{user.username}}",
    "password": "{{user.password}}",
    "server_name": "{{param.jls_server_name}}",
    "sni": "{{param.jls_server_name}}",
    "alpn": [
      "h3"
    ],
    "congestion_control": "bbr",
    "keep_alive_interval": "15s",
    "idle_timeout": "30s",
    "zero_rtt": true,
    "recv_window_conn": 15728640,
    "recv_window": 67108864,
    "max_datagram_frame_size": 1200
  },
  "requirements": {
    "udp": true,
    "quic": true,
    "build_tag": "with_shadowquic"
  },
  "client_notes": {
    "params": "optional bindings[].params overrides: jls_addr, jls_server_name"
  },
  "custom_preset": true,
  "optional_param_fields": [
    "jls_addr",
    "jls_server_name"
  ],
  "param_meta": {
    "jls_addr": {
      "type": "string",
      "widget": "text",
      "default": "www.cloudflare.com:443",
      "ui_group": "jls",
      "ui_order": 10,
      "title": {
        "en": "JLS upstream addr",
        "ru": "JLS upstream addr"
      },
      "description": {
        "en": "host:port for JLS camouflage QUIC upstream.",
        "ru": "host:port для JLS camouflage QUIC upstream."
      }
    },
    "jls_server_name": {
      "type": "string",
      "widget": "text",
      "default": "www.cloudflare.com",
      "ui_group": "jls",
      "ui_order": 11,
      "title": {
        "en": "JLS SNI",
        "ru": "JLS SNI"
      },
      "description": {
        "en": "TLS/QUIC SNI for JLS upstream; align with demux_sni on :443 stacks.",
        "ru": "SNI для JLS upstream; на demux :443 выравнивайте с demux_sni."
      }
    }
  }
}
