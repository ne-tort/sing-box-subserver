{
  "schema_version": 1,
  "tag": "shadowquic_custom",
  "protocol": "shadowquic",
  "aliases": [
    "shadowquic-custom"
  ],
  "short_name": "SQ 0-RTT custom",
  "status": "lab",
  "i18n": {
    "ru": {
      "title": "ShadowQUIC конструктор",
      "description": "ShadowQUIC: JLS addr/SNI + congestion/0-RTT/udp_over_stream. Для demux QUIC — предпочитайте shadowquic_jls."
    },
    "en": {
      "title": "ShadowQUIC constructor",
      "description": "ShadowQUIC: JLS addr/SNI plus congestion, 0-RTT, udp_over_stream. Prefer shadowquic_jls for demux QUIC substitutes."
    }
  },
  "traits": [
    "udp",
    "quic",
    "jls",
    "0rtt",
    "custom"
  ],
  "demux_hints": {
    "network": [
      "udp"
    ],
    "looks_like": "quic",
    "alpn": [
      "h3"
    ],
    "sni_required": true,
    "first_bytes": "QUIC 0-RTT",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 8,
    "speed": 9,
    "mobile": 5,
    "setup": 3
  },
  "cred_fields": [
    "username",
    "password"
  ],
  "inbound_template": {
    "type": "shadowquic",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "users": [],
    "jls_upstream": {
      "addr": "{{param.jls_addr}}",
      "server_name": "{{param.jls_server_name}}"
    },
    "alpn": [
      "h3"
    ],
    "congestion_control": "bbr",
    "idle_timeout": "30s",
    "zero_rtt": true,
    "recv_window_conn": 15728640,
    "recv_window": 67108864,
    "max_datagram_frame_size": 1200
  },
  "outbound_template": {
    "type": "shadowquic",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "username": "{{user.username}}",
    "password": "{{user.password}}",
    "server_name": "{{param.jls_server_name}}",
    "sni": "{{param.jls_server_name}}",
    "alpn": [
      "h3"
    ],
    "congestion_control": "bbr",
    "keep_alive_interval": "15s",
    "idle_timeout": "30s",
    "zero_rtt": true,
    "recv_window_conn": 15728640,
    "recv_window": 67108864,
    "max_datagram_frame_size": 1200
  },
  "requirements": {
    "udp": true,
    "quic": true,
    "build_tag": "with_shadowquic"
  },
  "client_notes": {
    "params": "optional bindings[].params overrides: jls_addr, jls_server_name"
  },
  "custom_preset": true,
  "optional_param_fields": [
    "jls_addr",
    "jls_server_name",
    "congestion_control",
    "zero_rtt",
    "udp_over_stream"
  ],
  "param_meta": {
    "jls_addr": {
      "type": "string",
      "widget": "text",
      "default": "www.cloudflare.com:443",
      "ui_group": "jls",
      "ui_order": 10,
      "title": {
        "en": "JLS upstream addr",
        "ru": "JLS upstream addr"
      },
      "description": {
        "en": "host:port for JLS camouflage QUIC upstream.",
        "ru": "host:port для JLS camouflage QUIC upstream."
      },
      "help": {
        "summary": {
          "en": "JLS upstream host:port used for camouflage QUIC. Must be reachable from the edge.",
          "ru": "JLS upstream host:port для camouflage QUIC. Должен быть доступен с edge."
        }
      }
    },
    "jls_server_name": {
      "type": "string",
      "widget": "text",
      "default": "www.cloudflare.com",
      "ui_group": "jls",
      "ui_order": 11,
      "title": {
        "en": "JLS SNI",
        "ru": "JLS SNI"
      },
      "description": {
        "en": "TLS/QUIC SNI for JLS upstream; align with demux_sni on :443 stacks.",
        "ru": "SNI для JLS upstream; на demux :443 выравнивайте с demux_sni."
      },
      "help": {
        "summary": {
          "en": "JLS SNI / server_name. On demux :443 align with demux_sni or the front will fail match.",
          "ru": "JLS SNI / server_name. На demux :443 выравнивайте с demux_sni, иначе front не сматчит."
        }
      }
    },
    "congestion_control": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "bbr",
        "cubic",
        "new_reno"
      ],
      "default": "bbr",
      "ui_group": "quic",
      "ui_order": 20,
      "title": {
        "en": "Congestion control",
        "ru": "Congestion control"
      },
      "description": {
        "en": "QUIC congestion_control (bbr|cubic|new_reno).",
        "ru": "QUIC congestion_control (bbr|cubic|new_reno)."
      },
      "help": {
        "summary": {
          "en": "QUIC CC algorithm. bbr is the usual default for lossy/mobile paths.",
          "ru": "Алгоритм QUIC CC. bbr — обычный default на lossy/мобильных."
        },
        "input_hint": {
          "en": "bbr|cubic|new_reno",
          "ru": "bbr|cubic|new_reno"
        },
        "format": "bbr"
      }
    },
    "zero_rtt": {
      "type": "bool",
      "widget": "toggle",
      "default": "true",
      "ui_group": "quic",
      "ui_order": 21,
      "title": {
        "en": "0-RTT",
        "ru": "0-RTT"
      },
      "description": {
        "en": "zero_rtt QUIC handshake (replay trade-off).",
        "ru": "zero_rtt QUIC handshake (компромисс replay)."
      },
      "help": {
        "summary": {
          "en": "Enables 0-RTT. Faster resume; accept replay risk on the application path.",
          "ru": "Включает 0-RTT. Быстрее resume; принимаете риск replay на application path."
        }
      }
    },
    "udp_over_stream": {
      "type": "bool",
      "widget": "toggle",
      "default": "false",
      "ui_group": "quic",
      "ui_order": 22,
      "title": {
        "en": "UDP over stream",
        "ru": "UDP over stream"
      },
      "description": {
        "en": "Outbound udp_over_stream — UDP frames over QUIC stream.",
        "ru": "Outbound udp_over_stream — UDP frames поверх QUIC stream."
      },
      "help": {
        "summary": {
          "en": "Outbound-only. Use when native UDP datagrams are filtered but stream path works.",
          "ru": "Только outbound. Когда native UDP datagram режут, а stream path проходит."
        }
      }
    }
  }
}
