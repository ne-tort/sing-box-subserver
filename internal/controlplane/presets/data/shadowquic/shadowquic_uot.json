{
  "schema_version": 1,
  "tag": "shadowquic_uot",
  "protocol": "shadowquic",
  "aliases": [
    "shadowquic-uot"
  ],
  "short_name": "SQ UoS",
  "status": "lab",
  "i18n": {
    "ru": {
      "title": "ShadowQUIC UDP-over-stream",
      "description": "ShadowQUIC JLS + outbound udp_over_stream (UDP поверх stream)."
    },
    "en": {
      "title": "ShadowQUIC UoT",
      "description": "ShadowQUIC UDP-over-TCP variant when raw UDP is filtered."
    }
  },
  "traits": [
    "udp",
    "quic",
    "jls",
    "uot"
  ],
  "demux_hints": {
    "network": [
      "udp"
    ],
    "looks_like": "quic",
    "alpn": [
      "h3"
    ],
    "sni_required": true,
    "first_bytes": "QUIC ClientHello → JLS upstream",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 9,
    "speed": 8,
    "mobile": 5,
    "setup": 5
  },
  "cred_fields": [
    "username",
    "password"
  ],
  "inbound_template": {
    "type": "shadowquic",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "users": [],
    "jls_upstream": {
      "addr": "{{param.jls_addr}}",
      "server_name": "{{param.jls_server_name}}",
      "quic_version_probe": true
    },
    "alpn": [
      "h3"
    ],
    "quic_versions": [
      "v1"
    ],
    "congestion_control": "bbr",
    "idle_timeout": "30s",
    "zero_rtt": false,
    "recv_window_conn": 15728640,
    "recv_window": 67108864,
    "max_datagram_frame_size": 1200
  },
  "outbound_template": {
    "type": "shadowquic",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "username": "{{user.username}}",
    "password": "{{user.password}}",
    "server_name": "{{param.jls_server_name}}",
    "sni": "{{param.jls_server_name}}",
    "alpn": [
      "h3"
    ],
    "quic_versions": [
      "v1"
    ],
    "congestion_control": "bbr",
    "keep_alive_interval": "15s",
    "idle_timeout": "30s",
    "udp_over_stream": true,
    "zero_rtt": false,
    "recv_window_conn": 15728640,
    "recv_window": 67108864,
    "max_datagram_frame_size": 1200
  },
  "requirements": {
    "udp": true,
    "quic": true,
    "build_tag": "with_shadowquic"
  },
  "client_notes": {
    "jls_upstream": "должен быть доступен с edge; SNI outbound обычно совпадает",
    "params": "optional bindings[].params overrides: jls_addr, jls_server_name"
  },
  "optional_param_fields": [
    "jls_addr",
    "jls_server_name"
  ],
  "param_meta": {
    "jls_addr": {
      "type": "string",
      "widget": "text",
      "default": "www.cloudflare.com:443",
      "ui_group": "jls",
      "ui_order": 10,
      "title": {
        "en": "JLS upstream addr",
        "ru": "JLS upstream addr"
      },
      "description": {
        "en": "host:port for JLS camouflage QUIC upstream.",
        "ru": "host:port для JLS camouflage QUIC upstream."
      }
    },
    "jls_server_name": {
      "type": "string",
      "widget": "text",
      "default": "www.cloudflare.com",
      "ui_group": "jls",
      "ui_order": 11,
      "title": {
        "en": "JLS SNI",
        "ru": "JLS SNI"
      },
      "description": {
        "en": "TLS/QUIC SNI for JLS upstream; align with demux_sni on :443 stacks.",
        "ru": "SNI для JLS upstream; на demux :443 выравнивайте с demux_sni."
      }
    }
  }
}
