{
  "schema_version": 1,
  "tag": "derp_custom",
  "protocol": "derp",
  "aliases": [
    "derp-custom"
  ],
  "short_name": "DERP TLS custom",
  "status": "lab",
  "i18n": {
    "ru": {
      "title": "DERP конструктор",
      "description": "DERP: path, websocket, udp mode, uTLS fingerprint."
    },
    "en": {
      "title": "DERP constructor",
      "description": "DERP: path, websocket, udp mode, uTLS fingerprint."
    }
  },
  "traits": [
    "tcp",
    "tls",
    "curve25519",
    "custom"
  ],
  "demux_hints": {
    "network": [
      "tcp"
    ],
    "looks_like": "tls_clienthello",
    "alpn": [
      "http/1.1",
      "h2"
    ],
    "sni_required": true,
    "first_bytes": "TLS → DERP upgrade/WS",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 7,
    "speed": 6,
    "mobile": 5,
    "setup": 3
  },
  "cred_fields": [
    "private_key",
    "public_key"
  ],
  "cred_generators": {
    "private_key": "curve25519"
  },
  "peer_secret_fields": {
    "private_key": "curve25519",
    "public_key": "curve25519"
  },
  "inbound_template": {
    "type": "derp",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "private_key": "{{peer.private_key}}",
    "users": [],
    "require_users": true,
    "udp": "native",
    "tailscale_relay": false,
    "path": "{{param.path}}",
    "websocket": false,
    "keepalive": "60s",
    "home": "s-ui derp",
    "max_packet_size": 65536,
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "http/1.1",
        "h2"
      ]
    }
  },
  "outbound_template": {
    "type": "derp",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "private_key": "{{user.private_key}}",
    "peer_public_key": "{{peer.public_key}}",
    "udp": "native",
    "path": "{{param.path}}",
    "host": "{{server}}",
    "websocket": false,
    "keepalive": "60s",
    "connect_timeout": "10s",
    "max_packet_size": 65536,
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "http/1.1",
        "h2"
      ],
      "utls": {
        "enabled": true,
        "fingerprint": "{{param.fingerprint}}"
      }
    }
  },
  "requirements": {
    "tls_profile": true,
    "build_tag": "with_derp"
  },
  "client_notes": {
    "keys": "server peer private/public + per-user private/public (curve25519 RawURL)",
    "peer_public_key": "subscription uses set.peer_secrets[preset/public_key]",
    "params": "optional bindings[].params overrides: path"
  },
  "custom_preset": true,
  "optional_param_fields": [
    "path",
    "websocket",
    "udp",
    "fingerprint"
  ],
  "param_meta": {
    "path": {
      "type": "string",
      "widget": "path",
      "default": "/derp",
      "ui_group": "transport",
      "ui_order": 42,
      "title": {
        "en": "Path",
        "ru": "Path"
      },
      "description": {
        "en": "HTTP/WebSocket path (DERP, etc.).",
        "ru": "HTTP/WebSocket path (DERP и др.)."
      }
    },
    "websocket": {
      "type": "bool",
      "widget": "toggle",
      "default": "false",
      "ui_group": "transport",
      "ui_order": 43,
      "title": {
        "en": "WebSocket",
        "ru": "WebSocket"
      },
      "description": {
        "en": "DERP websocket upgrade.",
        "ru": "DERP websocket upgrade."
      }
    },
    "udp": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "native",
        "uot"
      ],
      "default": "native",
      "ui_group": "transport",
      "ui_order": 44,
      "title": {
        "en": "UDP mode",
        "ru": "UDP mode"
      },
      "description": {
        "en": "DERP udp mode: native or uot (UDP-over-TCP / udp_over_tcp).",
        "ru": "DERP udp: native или uot (UDP-over-TCP / udp_over_tcp)."
      },
      "help": {
        "summary": {
          "en": "Wire values native|uot. uot aliases udp_over_tcp — carry UDP inside the DERP TCP/WS path when native UDP is filtered.",
          "ru": "Wire: native|uot. uot = udp_over_tcp — UDP внутри TCP/WS DERP, если native UDP режут."
        },
        "input_hint": {
          "en": "native|uot",
          "ru": "native|uot"
        },
        "format": "native"
      }
    },
    "fingerprint": {
      "type": "string",
      "widget": "text",
      "default": "chrome",
      "ui_group": "tls",
      "ui_order": 45,
      "title": {
        "en": "uTLS fingerprint",
        "ru": "uTLS fingerprint"
      },
      "description": {
        "en": "Outbound uTLS fingerprint.",
        "ru": "uTLS fingerprint на outbound."
      }
    }
  }
}
