{
  "schema_version": 1,
  "tag": "trusttunnel_custom",
  "protocol": "trusttunnel",
  "aliases": [
    "trusttunnel-custom"
  ],
  "short_name": "TT auto custom",
  "status": "lab",
  "i18n": {
    "ru": {
      "title": "TT auto custom (конструктор)",
      "description": "TrustTunnel конструктор: upstream_protocol h2|h3|auto для demux-ролей."
    },
    "en": {
      "title": "TrustTunnel constructor",
      "description": "Lab TrustTunnel: pick upstream_protocol h2, h3, or auto for demux-friendly stacks."
    }
  },
  "traits": [
    "tcp",
    "udp",
    "quic",
    "tls_custom",
    "http3",
    "auto",
    "custom"
  ],
  "demux_hints": {
    "network": [
      "udp"
    ],
    "looks_like": "quic",
    "alpn": [
      "h3"
    ],
    "sni_required": true,
    "first_bytes": "TLS or QUIC ClientHello (mode h2|h3|auto)",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 8,
    "speed": 8,
    "mobile": 4,
    "setup": 3
  },
  "cred_fields": [
    "username",
    "password"
  ],
  "param_fields": [
    "mode"
  ],
  "optional_param_fields": [
    "anti_dpi",
    "enable_protocol_fallback",
    "enable_udp",
    "force_http1_connect"
  ],
  "param_meta": {
    "mode": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "h2",
        "h3",
        "auto"
      ],
      "default": "auto",
      "ui_group": "transport",
      "ui_order": 1,
      "title": {
        "en": "Upstream protocol",
        "ru": "Upstream protocol"
      },
      "description": {
        "en": "TrustTunnel transport.upstream_protocol (UI h2→http2, h3→http3, auto).",
        "ru": "TrustTunnel transport.upstream_protocol (UI h2→http2, h3→http3, auto)."
      },
      "help": {
        "summary": {
          "en": "Maps to transport.upstream_protocol: h2→http2 (TCP/TLS), h3→http3 (QUIC), auto with optional fallback.",
          "ru": "Пишется в transport.upstream_protocol: h2→http2 (TCP/TLS), h3→http3 (QUIC), auto с optional fallback."
        }
      }
    },
    "anti_dpi": {
      "type": "bool",
      "widget": "toggle",
      "default": "true",
      "ui_group": "transport",
      "ui_order": 2,
      "title": {
        "en": "Anti-DPI",
        "ru": "Anti-DPI"
      },
      "description": {
        "en": "transport.anti_dpi — padding/timing hardening on TrustTunnel streams.",
        "ru": "transport.anti_dpi — hardening потоков TrustTunnel."
      },
      "help": {
        "summary": {
          "en": "transport.anti_dpi — padding/timing hardening on TrustTunnel streams.",
          "ru": "transport.anti_dpi — hardening потоков TrustTunnel (padding/timing)."
        }
      }
    },
    "enable_protocol_fallback": {
      "type": "bool",
      "widget": "toggle",
      "default": "true",
      "ui_group": "transport",
      "ui_order": 3,
      "visible_when": [
        {
          "key": "mode",
          "equals": "auto"
        }
      ],
      "title": {
        "en": "Protocol fallback",
        "ru": "Protocol fallback"
      },
      "description": {
        "en": "When mode=auto: enable_protocol_fallback between h2/h3.",
        "ru": "При mode=auto: enable_protocol_fallback между h2/h3."
      },
      "help": {
        "summary": {
          "en": "When mode=auto: allow h2↔h3 protocol fallback on TrustTunnel transport.",
          "ru": "При mode=auto: разрешить fallback h2↔h3 на TrustTunnel transport."
        }
      }
    },
    "enable_udp": {
      "type": "bool",
      "widget": "toggle",
      "default": "true",
      "ui_group": "transport",
      "ui_order": 4,
      "title": {
        "en": "Enable UDP",
        "ru": "Enable UDP"
      },
      "description": {
        "en": "enable_udp — advertise UDP via TrustTunnel _udp2 stream.",
        "ru": "enable_udp — UDP через поток TrustTunnel _udp2."
      },
      "help": {
        "summary": {
          "en": "When false, only TCP is advertised. UDP uses the TrustTunnel _udp2 stream.",
          "ru": "false — только TCP. UDP идёт через поток TrustTunnel _udp2."
        }
      }
    },
    "force_http1_connect": {
      "type": "bool",
      "widget": "toggle",
      "default": "false",
      "ui_group": "transport",
      "ui_order": 5,
      "title": {
        "en": "Force HTTP/1.1 CONNECT",
        "ru": "Force HTTP/1.1 CONNECT"
      },
      "description": {
        "en": "transport.force_http1_connect — legacy CONNECT fallback.",
        "ru": "transport.force_http1_connect — legacy CONNECT fallback."
      },
      "help": {
        "summary": {
          "en": "Compatibility: force HTTP/1.1 CONNECT instead of H2/H3 framing.",
          "ru": "Совместимость: форсировать HTTP/1.1 CONNECT вместо H2/H3 framing."
        }
      }
    }
  },
  "inbound_template": {
    "type": "trusttunnel",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "hostname": "{{server}}",
    "users": [],
    "tls": {
      "server_name": "{{server}}"
    },
    "transport": {
      "upstream_protocol": "auto",
      "anti_dpi": true,
      "enable_protocol_fallback": true,
      "protocol_fallback_delay": "1s",
      "connection_timeout": "10s",
      "initial_stream_window": 8388608,
      "initial_connection_window": 16777216,
      "disable_header_compression": false
    },
    "enable_tcp": true,
    "enable_udp": true,
    "enable_icmp": false
  },
  "outbound_template": {
    "type": "trusttunnel",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "hostname": "{{server}}",
    "username": "{{user.username}}",
    "password": "{{user.password}}",
    "tls": {
      "server_name": "{{server}}",
      "skip_verification": true
    },
    "transport": {
      "upstream_protocol": "auto",
      "anti_dpi": true,
      "enable_protocol_fallback": true,
      "protocol_fallback_delay": "1s",
      "connection_timeout": "10s",
      "initial_stream_window": 8388608,
      "initial_connection_window": 16777216,
      "disable_header_compression": false
    },
    "headers": {
      "user_agent": "Mozilla/5.0",
      "app_name": "Chrome",
      "platform": "windows"
    },
    "enable_tcp": true,
    "enable_udp": true,
    "health_check": {
      "enabled": true,
      "interval": "30s",
      "timeout": "5s"
    }
  },
  "requirements": {
    "tls_profile": true,
    "udp": true,
    "quic": true,
    "build_tag": "with_trusttunnel"
  },
  "custom_preset": true
}
