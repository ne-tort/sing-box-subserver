{
  "schema_version": 1,
  "tag": "wg_awg2",
  "protocol": "wireguard",
  "aliases": ["awg2", "amnezia-wg2"],
  "short_name": "AWG2",
  "status": "stable",
  "i18n": {
    "ru": {
      "title": "AmneziaWG 2 + masquerade",
      "description": "AWG2 (jc/s/h) + всегда masquerade id/ip/ib. CPS i1–i5 не хранятся."
    }
  },
  "traits": ["udp", "endpoint", "wireguard", "awg", "masquerade"],
  "demux_hints": {
    "network": ["udp"],
    "looks_like": "raw_udp",
    "compatible_with_demux": false
  },
  "scores": { "dpi": 8, "speed": 9, "mobile": 7, "setup": 5 },
  "cred_fields": ["private_key", "public_key", "wg_host_index"],
  "cred_generators": {
    "private_key": "curve25519",
    "wg_host_index": "wg_host_index"
  },
  "requirements": { "build_tag": "with_awg" },
  "endpoint_template": {
    "type": "wireguard",
    "tag": "cp-wg",
    "mtu": 1280,
    "address": [],
    "private_key": "",
    "listen_port": 51820,
    "peers": []
  },
  "outbound_template": {
    "type": "wireguard",
    "tag": "{{tag}}",
    "mtu": 1280,
    "address": [],
    "private_key": "{{user.private_key}}",
    "peers": [
      {
        "address": "{{server}}",
        "port": 0,
        "public_key": "",
        "allowed_ips": [],
        "persistent_keepalive_interval": 25
      }
    ]
  },
  "client_notes": {
    "masquerade": "всегда; параметры генерируются на хабе"
  }
}
