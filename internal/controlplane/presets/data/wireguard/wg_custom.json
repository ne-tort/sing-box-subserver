{
  "schema_version": 1,
  "tag": "wg_custom",
  "protocol": "wireguard",
  "aliases": ["wireguard-custom", "wg-constructor"],
  "short_name": "WG custom",
  "status": "lab",
  "custom_preset": true,
  "i18n": {
    "ru": {
      "title": "WireGuard / AWG конструктор",
      "description": "Схема каталога для PUT /v1/controlplane/wg: MTU, listen_port, up/down Mbps, опциональные jc/jmin/jmax. Не ставится через from-presets."
    },
    "en": {
      "title": "WireGuard / AWG constructor",
      "description": "Catalog schema for PUT /v1/controlplane/wg: MTU, listen_port, up/down Mbps, optional jc/jmin/jmax. Not installable via from-presets."
    }
  },
  "traits": ["udp", "endpoint", "wireguard", "awg", "custom"],
  "demux_hints": {
    "network": ["udp"],
    "looks_like": "raw_udp",
    "compatible_with_demux": false
  },
  "scores": {
    "dpi": 5,
    "speed": 9,
    "mobile": 7,
    "setup": 3
  },
  "cred_fields": ["private_key", "public_key", "wg_host_index"],
  "cred_generators": {
    "private_key": "curve25519",
    "wg_host_index": "wg_host_index"
  },
  "requirements": {
    "build_tag": "with_awg"
  },
  "optional_param_fields": [
    "mtu",
    "listen_port",
    "up_mbps",
    "down_mbps",
    "jc",
    "jmin",
    "jmax"
  ],
  "param_meta": {
    "mtu": {
      "type": "uint16",
      "widget": "text",
      "default": "1408",
      "ui_group": "core",
      "ui_order": 1,
      "min": 576,
      "max": 65535,
      "title": {"en": "MTU", "ru": "MTU"},
      "description": {
        "en": "WireGuard interface MTU on the hub endpoint.",
        "ru": "MTU интерфейса WireGuard на hub endpoint."
      }
    },
    "listen_port": {
      "type": "uint16",
      "widget": "port",
      "default": "51820",
      "ui_group": "listen",
      "ui_order": 0,
      "title": {"en": "Listen port", "ru": "Порт listen"},
      "description": {
        "en": "UDP listen port on the WG hub (endpoint).",
        "ru": "UDP-порт hub endpoint."
      }
    },
    "up_mbps": {
      "type": "uint16",
      "widget": "text",
      "ui_group": "core",
      "ui_order": 2,
      "min": 1,
      "max": 10000,
      "title": {"en": "Upload Mbps", "ru": "Upload Mbps"},
      "description": {
        "en": "Optional hub-wide upload Mbps ceiling.",
        "ru": "Опциональный потолок upload (Mbps) на hub."
      }
    },
    "down_mbps": {
      "type": "uint16",
      "widget": "text",
      "ui_group": "core",
      "ui_order": 3,
      "min": 1,
      "max": 10000,
      "title": {"en": "Download Mbps", "ru": "Download Mbps"},
      "description": {
        "en": "Optional hub-wide download Mbps ceiling.",
        "ru": "Опциональный потолок download (Mbps) на hub."
      }
    },
    "jc": {
      "type": "uint16",
      "widget": "text",
      "ui_group": "awg",
      "ui_order": 10,
      "title": {"en": "AWG jc", "ru": "AWG jc"},
      "description": {
        "en": "Override AmneziaWG junk packet count after profile generate.",
        "ru": "Override числа junk AmneziaWG после generate профиля."
      }
    },
    "jmin": {
      "type": "uint16",
      "widget": "text",
      "ui_group": "awg",
      "ui_order": 11,
      "title": {"en": "AWG jmin", "ru": "AWG jmin"},
      "description": {
        "en": "Lower junk packet size bound (AmneziaWG).",
        "ru": "Нижняя граница размера junk-пакета (AmneziaWG)."
      }
    },
    "jmax": {
      "type": "uint16",
      "widget": "text",
      "ui_group": "awg",
      "ui_order": 12,
      "title": {"en": "AWG jmax", "ru": "AWG jmax"},
      "description": {
        "en": "Upper junk packet size; must be >= jmin.",
        "ru": "Верхняя граница junk; должна быть >= jmin."
      }
    }
  },
  "endpoint_template": {
    "type": "wireguard",
    "tag": "cp-wg",
    "mtu": 1408,
    "address": [],
    "private_key": "",
    "listen_port": 51820,
    "peers": []
  },
  "outbound_template": {
    "type": "wireguard",
    "tag": "{{tag}}",
    "mtu": 1408,
    "address": [],
    "private_key": "{{user.private_key}}",
    "peers": [
      {
        "address": "{{server}}",
        "port": 0,
        "public_key": "",
        "allowed_ips": [],
        "persistent_keepalive_interval": 25
      }
    ]
  },
  "client_notes": {
    "endpoint": "Managed exclusively via PUT /v1/controlplane/wg (singleton hub). Rejected by sets/from-presets.",
    "awg": "Profile wg_awg2|wg_awg3 auto-generates AWG bundle; jc/jmin/jmax in PUT body override after generate. i1–i5 are stripped by materialize."
  }
}
