{
  "schema_version": 1,
  "tag": "carrier_jitsi_sei_shared",
  "protocol": "carrier",
  "aliases": [
    "carrier-jitsi-sei-shared"
  ],
  "short_name": "Jitsi SEI s",
  "status": "lab",
  "i18n": {
    "ru": {
      "title": "Carrier Jitsi SEI (shared)",
      "description": "Jitsi SFU transport=seichannel; params.room обязателен."
    },
    "en": {
      "title": "Carrier Jitsi SEI shared",
      "description": "Jitsi + SEI channel transport (shared). Use when datachannel path is filtered."
    }
  },
  "traits": [
    "tcp",
    "shared_auth",
    "wg_star",
    "sfu",
    "no_registration",
    "jitsi",
    "seichannel"
  ],
  "demux_hints": {
    "network": [
      "tcp"
    ],
    "looks_like": "raw_tcp",
    "alpn": [],
    "sni_required": false,
    "first_bytes": "carrier underlay",
    "compatible_with_demux": false
  },
  "scores": {
    "dpi": 7,
    "speed": 5,
    "mobile": 4,
    "setup": 5
  },
  "cred_fields": [
    "device_id"
  ],
  "inbound_template": {
    "type": "carrier",
    "tag": "{{tag}}",
    "provider": "jitsi",
    "auth": "shared",
    "link": {
      "room": "{{param.room}}",
      "transport": "seichannel",
      "password": "{{peer.password}}",
      "key": "{{param.key}}"
    },
    "lifecycle": {
      "enabled": true,
      "keepalive": true,
      "liveness_interval": "15s",
      "liveness_timeout": "5s",
      "liveness_failures": 3,
      "reconnect_backoff": "2s",
      "reconnect_backoff_max": "30s"
    }
  },
  "outbound_template": {
    "type": "carrier",
    "tag": "{{tag}}",
    "provider": "jitsi",
    "link": {
      "room": "{{param.room}}",
      "transport": "seichannel",
      "password": "{{peer.password}}",
      "device_id": "{{user.device_id}}",
      "key": "{{param.key}}"
    },
    "lifecycle": {
      "enabled": true,
      "keepalive": true,
      "liveness_interval": "15s",
      "liveness_timeout": "5s",
      "liveness_failures": 3,
      "reconnect_backoff": "2s",
      "reconnect_backoff_max": "30s"
    }
  },
  "requirements": {
    "build_tag": "with_carrier"
  },
  "client_notes": {
    "room": "required in bindings[].params.room; self-host = your Jitsi host in the URL",
    "transport": "datachannel|seichannel (vp8channel forbidden for jitsi)"
  },
  "peer_secret_fields": {
    "password": "password"
  },
  "param_fields": [
    "room"
  ],
  "param_meta": {
    "room": {
      "title": {
        "en": "Room URL",
        "ru": "URL комнаты"
      },
      "description": {
        "en": "Video-call room link used by the Carrier transport.",
        "ru": "Ссылка на комнату видеозвонка для Carrier."
      },
      "help": {
        "summary": {
          "en": "Full Jitsi room URL (https://host/Room). Self-host host must match the SFU you control.",
          "ru": "Полный URL комнаты Jitsi (https://host/Room). Host self-host должен совпадать с вашим SFU."
        },
        "input_hint": {
          "en": "Create a room on meet.jit.si and copy the link.",
          "ru": "Создайте комнату на meet.jit.si и скопируйте ссылку."
        },
        "format": "https://meet.jit.si/MyRoom"
      },
      "required_guide": {
        "title": {
          "en": "How to get a room URL",
          "ru": "Как получить URL комнаты"
        },
        "steps": [
          {
            "text": {
              "en": "Open Jitsi Meet",
              "ru": "Откройте Jitsi Meet"
            },
            "url": "https://meet.jit.si"
          },
          {
            "text": {
              "en": "Create a video-call room",
              "ru": "Создайте комнату видеозвонка"
            }
          },
          {
            "text": {
              "en": "Copy the room link and paste it into «Room URL»",
              "ru": "Скопируйте ссылку комнаты и вставьте в «URL комнаты»"
            }
          },
          {
            "text": {
              "en": "Example format: https://meet.jit.si/MyRoom",
              "ru": "Пример формата: https://meet.jit.si/MyRoom"
            }
          }
        ]
      }
    },
    "key": {
      "type": "string",
      "widget": "text",
      "ui_group": "carrier",
      "ui_order": 60,
      "title": {
        "en": "Room key",
        "ru": "Ключ комнаты"
      },
      "description": {
        "en": "Optional Carrier room key/token.",
        "ru": "Опциональный ключ/токен комнаты Carrier."
      }
    }
  },
  "optional_param_fields": [
    "key"
  ]
}
