{
  "schema_version": 1,
  "tag": "carrier_jitsi_sei_shared",
  "protocol": "carrier",
  "aliases": [
    "carrier-jitsi-sei-shared"
  ],
  "short_name": "Jitsi SEI s",
  "status": "lab",
  "i18n": {
    "ru": {
      "title": "Carrier Jitsi SEI (shared)",
      "description": "Jitsi SFU transport=seichannel; params.room обязателен."
    }
  },
  "traits": [
    "tcp",
    "shared_auth",
    "wg_star",
    "sfu",
    "no_registration",
    "jitsi",
    "seichannel"
  ],
  "demux_hints": {
    "network": [
      "tcp"
    ],
    "looks_like": "raw_tcp",
    "alpn": [],
    "sni_required": false,
    "first_bytes": "carrier underlay",
    "compatible_with_demux": false
  },
  "scores": {
    "dpi": 7,
    "speed": 5,
    "mobile": 4,
    "setup": 5
  },
  "cred_fields": [
    "device_id"
  ],
  "inbound_template": {
    "type": "carrier",
    "tag": "{{tag}}",
    "provider": "jitsi",
    "auth": "shared",
    "link": {
      "room": "{{param.room}}",
      "transport": "seichannel",
      "password": "{{peer.password}}",
      "key": "{{param.key}}"
    },
    "lifecycle": {
      "enabled": true,
      "keepalive": true,
      "liveness_interval": "15s",
      "liveness_timeout": "5s",
      "liveness_failures": 3,
      "reconnect_backoff": "2s",
      "reconnect_backoff_max": "30s"
    }
  },
  "outbound_template": {
    "type": "carrier",
    "tag": "{{tag}}",
    "provider": "jitsi",
    "link": {
      "room": "{{param.room}}",
      "transport": "seichannel",
      "password": "{{peer.password}}",
      "device_id": "{{user.device_id}}",
      "key": "{{param.key}}"
    },
    "lifecycle": {
      "enabled": true,
      "keepalive": true,
      "liveness_interval": "15s",
      "liveness_timeout": "5s",
      "liveness_failures": 3,
      "reconnect_backoff": "2s",
      "reconnect_backoff_max": "30s"
    }
  },
  "requirements": {
    "build_tag": "with_carrier"
  },
  "client_notes": {
    "room": "обязателен в bindings[].params.room; self-host = свой Jitsi host в URL",
    "transport": "datachannel|seichannel (vp8channel запрещён для jitsi)"
  },
  "peer_secret_fields": {
    "password": "password"
  },
  "param_fields": [
    "room"
  ]
}
