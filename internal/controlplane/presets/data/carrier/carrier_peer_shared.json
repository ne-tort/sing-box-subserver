{
  "schema_version": 1,
  "tag": "carrier_peer_shared",
  "protocol": "carrier",
  "aliases": [
    "carrier",
    "carrier-peer",
    "carrier-peer-shared"
  ],
  "short_name": "Carrier peer shared",
  "status": "lab",
  "i18n": {
    "ru": {
      "title": "Carrier peer shared",
      "description": "Self-host TCP peer underlay + shared password; client device_id. link.peer ← set listen:port."
    },
    "en": {
      "title": "Carrier peer shared",
      "description": "Direct peer underlay (self-host), shared auth. No public SFU — you run the peer endpoint."
    }
  },
  "traits": [
    "tcp",
    "shared_auth",
    "wg_star",
    "needs_listen",
    "self_host"
  ],
  "demux_hints": {
    "network": [
      "tcp"
    ],
    "looks_like": "raw_tcp",
    "alpn": [],
    "sni_required": false,
    "first_bytes": "carrier underlay",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 5,
    "speed": 6,
    "mobile": 3,
    "setup": 4
  },
  "cred_fields": [
    "device_id"
  ],
  "inbound_template": {
    "type": "carrier",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "provider": "peer",
    "auth": "shared",
    "link": {
      "peer": "{{listen}}:{{listen_port}}",
      "password": "{{peer.password}}"
    },
    "lifecycle": {
      "enabled": true,
      "keepalive": true,
      "liveness_interval": "15s",
      "liveness_timeout": "5s",
      "liveness_failures": 3,
      "reconnect_backoff": "2s",
      "reconnect_backoff_max": "30s"
    }
  },
  "outbound_template": {
    "type": "carrier",
    "tag": "{{tag}}",
    "provider": "peer",
    "link": {
      "peer": "{{server}}:{{listen_port}}",
      "password": "{{peer.password}}",
      "device_id": "{{user.device_id}}"
    },
    "lifecycle": {
      "enabled": true,
      "keepalive": true,
      "liveness_interval": "15s",
      "liveness_timeout": "5s",
      "liveness_failures": 3,
      "reconnect_backoff": "2s",
      "reconnect_backoff_max": "30s"
    }
  },
  "requirements": {
    "build_tag": "with_carrier"
  },
  "client_notes": {
    "peer": "self-host: inbound listens link.peer; outbound dials publicHost:listen_port"
  },
  "peer_secret_fields": {
    "password": "password"
  }
}
