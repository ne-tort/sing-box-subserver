{
  "schema_version": 1,
  "tag": "carrier_telemost_shared",
  "protocol": "carrier",
  "aliases": [
    "carrier-telemost",
    "carrier-telemost-shared"
  ],
  "short_name": "Carrier Telemost",
  "status": "lab",
  "i18n": {
    "ru": {
      "title": "Carrier Telemost",
      "description": "Yandex Telemost: guest join без Яндекс-логина. params.room=https://telemost.yandex.ru/j/<id>."
    },
    "en": {
      "title": "Carrier Telemost shared",
      "description": "Yandex Telemost SFU underlay, shared auth. Room URL from Telemost; good when Jitsi is blocked."
    }
  },
  "traits": [
    "tcp",
    "shared_auth",
    "wg_star",
    "sfu",
    "no_registration",
    "telemost"
  ],
  "demux_hints": {
    "network": [
      "tcp"
    ],
    "looks_like": "raw_tcp",
    "alpn": [],
    "sni_required": false,
    "first_bytes": "carrier underlay",
    "compatible_with_demux": false
  },
  "scores": {
    "dpi": 7,
    "speed": 5,
    "mobile": 5,
    "setup": 4
  },
  "cred_fields": [
    "device_id"
  ],
  "inbound_template": {
    "type": "carrier",
    "tag": "{{tag}}",
    "provider": "telemost",
    "auth": "shared",
    "link": {
      "room": "{{param.room}}",
      "transport": "vp8channel",
      "password": "{{peer.password}}"
    },
    "lifecycle": {
      "enabled": true,
      "keepalive": true,
      "liveness_interval": "15s",
      "liveness_timeout": "5s",
      "liveness_failures": 3,
      "reconnect_backoff": "2s",
      "reconnect_backoff_max": "30s"
    }
  },
  "outbound_template": {
    "type": "carrier",
    "tag": "{{tag}}",
    "provider": "telemost",
    "link": {
      "room": "{{param.room}}",
      "transport": "vp8channel",
      "password": "{{peer.password}}",
      "device_id": "{{user.device_id}}"
    },
    "lifecycle": {
      "enabled": true,
      "keepalive": true,
      "liveness_interval": "15s",
      "liveness_timeout": "5s",
      "liveness_failures": 3,
      "reconnect_backoff": "2s",
      "reconnect_backoff_max": "30s"
    }
  },
  "requirements": {
    "build_tag": "with_carrier"
  },
  "client_notes": {
    "room": "встречу создаёт ops в UI Telemost; CP только join по URL"
  },
  "peer_secret_fields": {
    "password": "password"
  },
  "param_fields": [
    "room"
  ],
  "param_meta": {
    "room": {
      "title": {
        "en": "Room URL",
        "ru": "URL комнаты"
      },
      "description": {
        "en": "Yandex Telemost room link used by the Carrier transport.",
        "ru": "Ссылка на комнату Яндекс Телемост для Carrier."
      },
      "help": {
        "summary": {
          "en": "Full Telemost room URL (https://telemost.yandex.ru/j/<id>). Guest join; no Yandex login on agent.",
          "ru": "Полный URL комнаты Телемост (https://telemost.yandex.ru/j/<id>). Guest join; логин Яндекса на агенте не нужен."
        },
        "input_hint": {
          "en": "Create a room in Telemost and copy the link.",
          "ru": "Создайте комнату в Телемосте и скопируйте ссылку."
        },
        "format": "https://telemost.yandex.ru/j/…"
      },
      "required_guide": {
        "title": {
          "en": "How to get a Telemost room URL",
          "ru": "Как получить URL комнаты Телемост"
        },
        "steps": [
          {
            "text": {
              "en": "Open Yandex Telemost",
              "ru": "Откройте Яндекс Телемост"
            },
            "url": "https://telemost.yandex.ru"
          },
          {
            "text": {
              "en": "Create a video-call room",
              "ru": "Создайте комнату видеозвонка"
            }
          },
          {
            "text": {
              "en": "Copy the room link and paste it into «Room URL»",
              "ru": "Скопируйте ссылку комнаты и вставьте в «URL комнаты»"
            }
          }
        ]
      }
    }
  }
}
