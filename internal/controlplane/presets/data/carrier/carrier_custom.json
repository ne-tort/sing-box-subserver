{
  "schema_version": 1,
  "tag": "carrier_custom",
  "protocol": "carrier",
  "aliases": [
    "carrier-custom"
  ],
  "short_name": "Carrier custom",
  "status": "lab",
  "i18n": {
    "ru": {
      "title": "Carrier конструктор",
      "description": "SFU room URL + опциональный token; provider через params."
    },
    "en": {
      "title": "Carrier constructor",
      "description": "Lab Carrier: pick provider (jitsi/telemost/wbstream/jitsi_sei), room URL, optional token/key. Prefer a concrete SFU preset when possible."
    }
  },
  "traits": [
    "tcp",
    "shared_auth",
    "wg_star",
    "sfu",
    "no_registration",
    "jitsi"
  ],
  "demux_hints": {
    "network": [
      "tcp"
    ],
    "looks_like": "raw_tcp",
    "alpn": [],
    "sni_required": false,
    "first_bytes": "carrier underlay",
    "compatible_with_demux": false
  },
  "scores": {
    "dpi": 7,
    "speed": 5,
    "mobile": 4,
    "setup": 3
  },
  "cred_fields": [
    "device_id"
  ],
  "inbound_template": {
    "type": "carrier",
    "tag": "{{tag}}",
    "provider": "jitsi",
    "auth": "shared",
    "link": {
      "room": "{{param.room}}",
      "transport": "datachannel",
      "password": "{{peer.password}}",
      "key": "{{param.key}}",
      "token": "{{param.token}}"
    },
    "lifecycle": {
      "enabled": true,
      "keepalive": true,
      "liveness_interval": "15s",
      "liveness_timeout": "5s",
      "liveness_failures": 3,
      "reconnect_backoff": "2s",
      "reconnect_backoff_max": "30s"
    }
  },
  "outbound_template": {
    "type": "carrier",
    "tag": "{{tag}}",
    "provider": "jitsi",
    "link": {
      "room": "{{param.room}}",
      "transport": "datachannel",
      "password": "{{peer.password}}",
      "device_id": "{{user.device_id}}",
      "key": "{{param.key}}",
      "token": "{{param.token}}"
    },
    "lifecycle": {
      "enabled": true,
      "keepalive": true,
      "liveness_interval": "15s",
      "liveness_timeout": "5s",
      "liveness_failures": 3,
      "reconnect_backoff": "2s",
      "reconnect_backoff_max": "30s"
    }
  },
  "requirements": {
    "build_tag": "with_carrier"
  },
  "client_notes": {
    "room": "required in bindings[].params.room; self-host = your Jitsi host in the URL",
    "provider": "jitsi|telemost|wbstream|jitsi_sei → materialize knobs (SEI = jitsi+seichannel)",
    "token": "optional; wbstream guest-register often requires token",
    "transport": "set by knobs from provider (datachannel|seichannel|vp8channel)"
  },
  "peer_secret_fields": {
    "password": "password"
  },
  "param_fields": [
    "room"
  ],
  "param_meta": {
    "room": {
      "type": "string",
      "widget": "text",
      "title": {
        "en": "Room URL",
        "ru": "URL комнаты"
      },
      "description": {
        "en": "SFU room URL (meet.jit.si/Room, Telemost, WB Stream, or self-hosted Jitsi).",
        "ru": "URL комнаты SFU (meet.jit.si/Room, Telemost, WB Stream или self-host Jitsi)."
      },
      "required_guides": [
        {
          "visible_when": [{"key": "provider", "equals": "jitsi"}],
          "title": {
            "en": "Jitsi Meet room",
            "ru": "Комната Jitsi Meet"
          },
          "steps": [
            {
              "text": {
                "en": "Open public Jitsi (meet.jit.si) or your self-hosted Jitsi",
                "ru": "Откройте публичный Jitsi (meet.jit.si) или свой self-host"
              },
              "url": "https://meet.jit.si"
            },
            {
              "text": {
                "en": "Create a room and copy https://host/RoomName (self-host = your SFU host)",
                "ru": "Создайте комнату и скопируйте https://host/RoomName (self-host = ваш SFU)"
              }
            },
            {
              "text": {
                "en": "Paste into Room URL",
                "ru": "Вставьте в URL комнаты"
              }
            }
          ]
        },
        {
          "visible_when": [{"key": "provider", "equals": "jitsi_sei"}],
          "title": {
            "en": "Jitsi SEI room",
            "ru": "Комната Jitsi SEI"
          },
          "steps": [
            {
              "text": {
                "en": "Same as Jitsi Meet: public meet.jit.si or self-hosted SFU URL",
                "ru": "Как у Jitsi Meet: meet.jit.si или self-host SFU URL"
              },
              "url": "https://meet.jit.si"
            },
            {
              "text": {
                "en": "Transport will use seichannel (set automatically)",
                "ru": "Транспорт seichannel выставится автоматически"
              }
            }
          ]
        },
        {
          "visible_when": [{"key": "provider", "equals": "telemost"}],
          "title": {
            "en": "Yandex Telemost room",
            "ru": "Комната Яндекс Телемост"
          },
          "steps": [
            {
              "text": {
                "en": "Open Yandex Telemost",
                "ru": "Откройте Яндекс Телемост"
              },
              "url": "https://telemost.yandex.ru"
            },
            {
              "text": {
                "en": "Create a video-call and copy https://telemost.yandex.ru/j/…",
                "ru": "Создайте звонок и скопируйте https://telemost.yandex.ru/j/…"
              }
            }
          ]
        },
        {
          "visible_when": [{"key": "provider", "equals": "wbstream"}],
          "title": {
            "en": "WB Stream room",
            "ru": "Комната WB Stream"
          },
          "steps": [
            {
              "text": {
                "en": "Open the WB Stream room / broadcast page",
                "ru": "Откройте страницу комнаты / трансляции WB Stream"
              }
            },
            {
              "text": {
                "en": "Copy the full room URL; guest-register often needs Token too",
                "ru": "Скопируйте полный URL; для guest-register часто нужен и Token"
              }
            }
          ]
        },
        {
          "title": {
            "en": "SFU room URL",
            "ru": "URL комнаты SFU"
          },
          "steps": [
            {
              "text": {
                "en": "Pick a provider above, then paste the matching room URL",
                "ru": "Выберите провайдера выше, затем вставьте подходящий URL комнаты"
              }
            }
          ]
        }
      ]
    },
    "token": {
      "type": "string",
      "widget": "text",
      "title": {
        "en": "Token",
        "ru": "Токен"
      },
      "description": {
        "en": "Optional SFU join token (WB Stream guest-register).",
        "ru": "Опциональный join-токен SFU (guest-register WB Stream)."
      }
    },
    "provider": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "jitsi",
        "telemost",
        "wbstream",
        "jitsi_sei"
      ],
      "default": "jitsi",
      "title": {
        "en": "Provider",
        "ru": "Провайдер"
      },
      "description": {
        "en": "SFU provider. jitsi_sei → provider=jitsi + transport=seichannel.",
        "ru": "SFU-провайдер. jitsi_sei → provider=jitsi + transport=seichannel."
      }
    },
    "key": {
      "type": "string",
      "widget": "text",
      "ui_group": "carrier",
      "ui_order": 60,
      "title": {
        "en": "Room key",
        "ru": "Ключ комнаты"
      },
      "description": {
        "en": "Optional Carrier room key (link.key).",
        "ru": "Опциональный ключ комнаты Carrier (link.key)."
      }
    }
  },
  "custom_preset": true,
  "optional_param_fields": [
    "key",
    "provider",
    "token"
  ]
}
