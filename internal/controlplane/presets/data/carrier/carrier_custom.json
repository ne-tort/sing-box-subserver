{
  "schema_version": 1,
  "tag": "carrier_custom",
  "protocol": "carrier",
  "aliases": [
    "carrier-custom"
  ],
  "short_name": "Carrier custom",
  "status": "lab",
  "i18n": {
    "ru": {
      "title": "Carrier конструктор",
      "description": "SFU room URL + опциональный token; provider через params."
    },
    "en": {
      "title": "Carrier constructor",
      "description": "Lab Carrier: pick provider (jitsi/telemost/wbstream/jitsi_sei), room URL, optional token/key. Prefer a concrete SFU preset when possible."
    }
  },
  "traits": [
    "tcp",
    "shared_auth",
    "wg_star",
    "sfu",
    "no_registration",
    "jitsi"
  ],
  "demux_hints": {
    "network": [
      "tcp"
    ],
    "looks_like": "raw_tcp",
    "alpn": [],
    "sni_required": false,
    "first_bytes": "carrier underlay",
    "compatible_with_demux": false
  },
  "scores": {
    "dpi": 7,
    "speed": 5,
    "mobile": 4,
    "setup": 3
  },
  "cred_fields": [
    "device_id"
  ],
  "inbound_template": {
    "type": "carrier",
    "tag": "{{tag}}",
    "provider": "jitsi",
    "auth": "shared",
    "link": {
      "room": "{{param.room}}",
      "transport": "datachannel",
      "password": "{{peer.password}}",
      "key": "{{param.key}}",
      "token": "{{param.token}}"
    },
    "lifecycle": {
      "enabled": true,
      "keepalive": true,
      "liveness_interval": "15s",
      "liveness_timeout": "5s",
      "liveness_failures": 3,
      "reconnect_backoff": "2s",
      "reconnect_backoff_max": "30s"
    }
  },
  "outbound_template": {
    "type": "carrier",
    "tag": "{{tag}}",
    "provider": "jitsi",
    "link": {
      "room": "{{param.room}}",
      "transport": "datachannel",
      "password": "{{peer.password}}",
      "device_id": "{{user.device_id}}",
      "key": "{{param.key}}",
      "token": "{{param.token}}"
    },
    "lifecycle": {
      "enabled": true,
      "keepalive": true,
      "liveness_interval": "15s",
      "liveness_timeout": "5s",
      "liveness_failures": 3,
      "reconnect_backoff": "2s",
      "reconnect_backoff_max": "30s"
    }
  },
  "requirements": {
    "build_tag": "with_carrier"
  },
  "client_notes": {
    "room": "обязателен в bindings[].params.room; self-host = свой Jitsi host в URL",
    "provider": "jitsi|telemost|wbstream|jitsi_sei → materialize knobs (SEI = jitsi+seichannel)",
    "token": "опц.; wbstream guest-register часто требует token",
    "transport": "ставится knobs по provider (datachannel|seichannel|vp8channel)"
  },
  "peer_secret_fields": {
    "password": "password"
  },
  "param_fields": [
    "room"
  ],
  "param_meta": {
    "room": {
      "type": "string",
      "widget": "text",
      "title": {
        "en": "Room URL",
        "ru": "URL комнаты"
      },
      "description": {
        "en": "SFU room URL (meet.jit.si/Room, Telemost, WB Stream, …).",
        "ru": "URL комнаты SFU (meet.jit.si/Room, Telemost, WB Stream, …)."
      }
    },
    "token": {
      "type": "string",
      "widget": "text",
      "title": {
        "en": "Token",
        "ru": "Токен"
      },
      "description": {
        "en": "Optional SFU join token (WB Stream guest-register).",
        "ru": "Опциональный join-токен SFU (guest-register WB Stream)."
      }
    },
    "provider": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "jitsi",
        "telemost",
        "wbstream",
        "jitsi_sei"
      ],
      "default": "jitsi",
      "title": {
        "en": "Provider",
        "ru": "Провайдер"
      },
      "description": {
        "en": "SFU provider. jitsi_sei → provider=jitsi + transport=seichannel.",
        "ru": "SFU-провайдер. jitsi_sei → provider=jitsi + transport=seichannel."
      }
    },
    "key": {
      "type": "string",
      "widget": "text",
      "ui_group": "carrier",
      "ui_order": 60,
      "title": {
        "en": "Room key",
        "ru": "Ключ комнаты"
      },
      "description": {
        "en": "Optional Carrier room key (link.key).",
        "ru": "Опциональный ключ комнаты Carrier (link.key)."
      }
    }
  },
  "custom_preset": true,
  "optional_param_fields": [
    "key",
    "provider",
    "token"
  ]
}
