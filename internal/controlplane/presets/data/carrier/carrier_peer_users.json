{
  "schema_version": 1,
  "tag": "carrier_peer_users",
  "protocol": "carrier",
  "aliases": [
    "carrier-peer-users"
  ],
  "short_name": "Carrier peer users",
  "status": "lab",
  "i18n": {
    "ru": {
      "title": "Carrier peer users",
      "description": "Self-host peer + auth=users (device_id/secret ACL)."
    }
  },
  "traits": [
    "tcp",
    "users_auth",
    "wg_star",
    "needs_listen",
    "self_host"
  ],
  "demux_hints": {
    "network": [
      "tcp"
    ],
    "looks_like": "raw_tcp",
    "alpn": [],
    "sni_required": false,
    "first_bytes": "carrier underlay",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 5,
    "speed": 6,
    "mobile": 3,
    "setup": 4
  },
  "cred_fields": [
    "device_id",
    "secret"
  ],
  "inbound_template": {
    "type": "carrier",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "provider": "peer",
    "auth": "users",
    "users": [],
    "link": {
      "peer": "{{listen}}:{{listen_port}}",
      "password": "{{peer.password}}"
    },
    "lifecycle": {
      "enabled": true,
      "keepalive": true,
      "liveness_interval": "15s",
      "liveness_timeout": "5s",
      "liveness_failures": 3,
      "reconnect_backoff": "2s",
      "reconnect_backoff_max": "30s"
    }
  },
  "outbound_template": {
    "type": "carrier",
    "tag": "{{tag}}",
    "provider": "peer",
    "link": {
      "peer": "{{server}}:{{listen_port}}",
      "password": "{{user.secret}}",
      "device_id": "{{user.device_id}}"
    },
    "lifecycle": {
      "enabled": true,
      "keepalive": true,
      "liveness_interval": "15s",
      "liveness_timeout": "5s",
      "liveness_failures": 3,
      "reconnect_backoff": "2s",
      "reconnect_backoff_max": "30s"
    }
  },
  "requirements": {
    "build_tag": "with_carrier"
  },
  "client_notes": {},
  "peer_secret_fields": {
    "password": "password"
  }
}
