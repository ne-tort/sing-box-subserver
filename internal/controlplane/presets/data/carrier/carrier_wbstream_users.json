{
  "schema_version": 1,
  "tag": "carrier_wbstream_users",
  "protocol": "carrier",
  "aliases": [
    "carrier-wbstream-users"
  ],
  "short_name": "Carrier WB users",
  "status": "lab",
  "i18n": {
    "ru": {
      "title": "Carrier WB users",
      "description": "WB Stream + auth=users; params.room обязателен."
    },
    "en": {
      "title": "Carrier WB Stream users",
      "description": "WB stream underlay with per-user credentials."
    }
  },
  "traits": [
    "tcp",
    "users_auth",
    "wg_star",
    "sfu",
    "no_registration",
    "wbstream"
  ],
  "demux_hints": {
    "network": [
      "tcp"
    ],
    "looks_like": "raw_tcp",
    "alpn": [],
    "sni_required": false,
    "first_bytes": "carrier underlay",
    "compatible_with_demux": false
  },
  "scores": {
    "dpi": 6,
    "speed": 5,
    "mobile": 4,
    "setup": 3
  },
  "cred_fields": [
    "device_id",
    "secret"
  ],
  "inbound_template": {
    "type": "carrier",
    "tag": "{{tag}}",
    "provider": "wbstream",
    "auth": "users",
    "users": [],
    "link": {
      "room": "{{param.room}}",
      "transport": "vp8channel",
      "password": "{{peer.password}}",
      "token": "{{param.token}}"
    },
    "lifecycle": {
      "enabled": true,
      "keepalive": true,
      "liveness_interval": "15s",
      "liveness_timeout": "5s",
      "liveness_failures": 3,
      "reconnect_backoff": "2s",
      "reconnect_backoff_max": "30s"
    }
  },
  "outbound_template": {
    "type": "carrier",
    "tag": "{{tag}}",
    "provider": "wbstream",
    "link": {
      "room": "{{param.room}}",
      "transport": "vp8channel",
      "password": "{{user.secret}}",
      "device_id": "{{user.device_id}}",
      "token": "{{param.token}}"
    },
    "lifecycle": {
      "enabled": true,
      "keepalive": true,
      "liveness_interval": "15s",
      "liveness_timeout": "5s",
      "liveness_failures": 3,
      "reconnect_backoff": "2s",
      "reconnect_backoff_max": "30s"
    }
  },
  "requirements": {
    "build_tag": "with_carrier"
  },
  "client_notes": {},
  "peer_secret_fields": {
    "password": "password"
  },
  "param_fields": [
    "room"
  ],
  "param_meta": {
    "room": {
      "title": {
        "en": "Room URL",
        "ru": "URL комнаты"
      },
      "description": {
