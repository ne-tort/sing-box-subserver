{
  "schema_version": 1,
  "tag": "vmess_grpc_tls",
  "protocol": "vmess",
  "aliases": [
    "vmess-grpc-tls"
  ],
  "short_name": "VMess gRPC",
  "status": "stable",
  "i18n": {
    "ru": {
      "title": "VMess gRPC TLS",
      "description": "VMess + TLS + gRPC."
    },
    "en": {
      "title": "VMess gRPC TLS",
      "description": "VMess + TLS + gRPC/H2. Demux TLS slot candidate with distinct SNI."
    }
  },
  "traits": [
    "tcp",
    "tls",
    "grpc"
  ],
  "demux_hints": {
    "network": [
      "tcp"
    ],
    "looks_like": "tls_clienthello",
    "alpn": [],
    "sni_required": true,
    "first_bytes": "TLS then grpc",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 6,
    "speed": 6,
    "mobile": 5,
    "setup": 6
  },
  "cred_fields": [
    "uuid"
  ],
  "default_client_profiles": [
    "sec-auto"
  ],
  "inbound_template": {
    "type": "vmess",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "users": [],
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2"
      ]
    },
    "transport": {
      "type": "grpc",
      "service_name": "{{param.service_name}}",
      "idle_timeout": "15s",
      "ping_timeout": "15s",
      "permit_without_stream": false
    }
  },
  "outbound_template": {
    "type": "vmess",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "uuid": "{{user.uuid}}",
    "security": "auto",
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2"
      ],
      "utls": {
        "enabled": true,
        "fingerprint": "chrome"
      }
    },
    "transport": {
      "type": "grpc",
      "service_name": "{{param.service_name}}",
      "idle_timeout": "15s",
      "ping_timeout": "15s",
      "permit_without_stream": false
    }
  },
  "requirements": {
    "tls_profile": true
  },
  "client_notes": {
    "security": "outbound-only: sec-auto / sec-aes128 / sec-chacha / pkt-xudp via enabled_client_profiles"
  },
  "optional_param_fields": [
    "service_name",
    "fingerprint"
  ],
  "param_meta": {
    "service_name": {
      "type": "string",
      "widget": "text",
      "default": "VMessService",
      "ui_group": "transport",
      "ui_order": 36,
      "title": {
        "en": "gRPC service name",
        "ru": "gRPC service name"
      },
      "description": {
        "en": "gRPC Gun service_name for VMess (stock VMessService).",
        "ru": "gRPC Gun service_name для VMess (дефолт VMessService)."
      }
    },
    "fingerprint": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "chrome",
        "firefox",
        "safari",
        "edge",
        "ios",
        "android",
        "random"
      ],
      "default": "chrome",
      "ui_group": "tls",
      "ui_order": 90,
      "title": {
        "en": "uTLS fingerprint",
        "ru": "uTLS fingerprint"
      },
      "description": {
        "en": "Outbound uTLS ClientHello fingerprint.",
        "ru": "uTLS fingerprint ClientHello на outbound."
      },
      "help": {
        "summary": {
          "en": "Outbound uTLS fingerprint. Override the template default (usually chrome).",
          "ru": "uTLS fingerprint на outbound. Переопределяет default шаблона (обычно chrome)."
        },
        "input_hint": {
          "en": "chrome|firefox|…",
          "ru": "chrome|firefox|…"
        },
        "format": "chrome"
      }
    }
  }
}
