{
  "schema_version": 1,
  "tag": "vmess_tls",
  "protocol": "vmess",
  "aliases": [
    "vmess-tls"
  ],
  "short_name": "VMess TLS",
  "status": "stable",
  "i18n": {
    "ru": {
      "title": "VMess TLS",
      "description": "VMess TCP с TLS-профилем CP."
    },
    "en": {
      "title": "VMess TLS",
      "description": "VMess + classic TLS. Weaker probing resistance than VLESS+Reality."
    }
  },
  "traits": [
    "tcp",
    "tls"
  ],
  "demux_hints": {
    "network": [
      "tcp"
    ],
    "looks_like": "tls_clienthello",
    "alpn": [],
    "sni_required": true,
    "first_bytes": "TLS ClientHello → VMess",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 5,
    "speed": 6,
    "mobile": 5,
    "setup": 7
  },
  "cred_fields": [
    "uuid"
  ],
  "inbound_template": {
    "type": "vmess",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "users": [],
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ]
    }
  },
  "outbound_template": {
    "type": "vmess",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "uuid": "{{user.uuid}}",
    "security": "auto",
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ],
      "utls": {
        "enabled": true,
        "fingerprint": "chrome"
      }
    }
  },
  "requirements": {
    "tls_profile": true
  },
  "default_client_profiles": [
    "sec-auto"
  ],
  "client_notes": {
    "security": "outbound-only profiles: sec-auto / sec-aes128 / sec-chacha / pkt-xudp"
  }
}
