{
  "schema_version": 1,
  "tag": "vmess_ws_reality",
  "protocol": "vmess",
  "aliases": [
    "vmess-ws-reality"
  ],
  "short_name": "VMess WS+R",
  "status": "stable",
  "i18n": {
    "ru": {
      "title": "VMess WS Reality",
      "description": "VMess + Reality + WebSocket (path/Host/early-data; uTLS chrome)."
    },
    "en": {
      "title": "VMess WS Reality",
      "description": "VMess + Reality + WebSocket. Reality outside; path still needed for fronts."
    }
  },
  "traits": [
    "tcp",
    "tls",
    "reality",
    "ws"
  ],
  "demux_hints": {
    "network": [
      "tcp"
    ],
    "looks_like": "tls_clienthello",
    "alpn": [
      "h2",
      "http/1.1"
    ],
    "sni_required": true,
    "first_bytes": "Reality TLS then WS",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 8,
    "speed": 5,
    "mobile": 5,
    "setup": 5
  },
  "cred_fields": [
    "uuid"
  ],
  "default_client_profiles": [
    "sec-auto"
  ],
  "inbound_template": {
    "type": "vmess",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "users": [],
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ]
    },
    "transport": {
      "type": "ws",
      "path": "{{param.ws_path}}",
      "headers": {
        "Host": [
          "{{param.ws_host}}"
        ],
        "User-Agent": [
          "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
        ]
      }
    }
  },
  "outbound_template": {
    "type": "vmess",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "uuid": "{{user.uuid}}",
    "security": "auto",
    "packet_encoding": "xudp",
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ],
      "utls": {
        "enabled": true,
        "fingerprint": "chrome"
      }
    },
    "transport": {
      "type": "ws",
      "path": "{{param.ws_path}}",
      "headers": {
        "Host": [
          "{{param.ws_host}}"
        ],
        "User-Agent": [
          "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
        ]
      }
    }
  },
  "requirements": {
    "tls_profile": true,
    "reality_assignment": true
  },
  "client_notes": {
    "params": "optional bindings[].params overrides: ws_host, ws_path",
    "ws_path_default": "/vmess",
    "early_data": "disabled by default for Reality WS (enable via template fork if needed)"
  },
  "optional_param_fields": [
    "ws_host",
    "ws_path",
    "fingerprint"
  ],
  "param_meta": {
    "ws_host": {
      "type": "string",
      "widget": "text",
      "ui_group": "transport",
      "ui_order": 31,
      "title": {
        "en": "WebSocket Host",
        "ru": "WebSocket Host"
      },
      "description": {
        "en": "Host header for WebSocket (defaults to server/SNI).",
        "ru": "Host header для WebSocket (по умолчанию server/SNI)."
      }
    },
    "ws_path": {
      "type": "string",
      "widget": "path",
      "default": "/vmess",
      "ui_group": "transport",
      "ui_order": 30,
      "title": {
        "en": "WebSocket path",
        "ru": "WebSocket path"
      },
      "description": {
        "en": "HTTP path for WebSocket after TLS.",
        "ru": "HTTP path для WebSocket после TLS."
      }
    },
    "fingerprint": {
      "type": "enum",
      "widget": "select",
      "enum": [
        "chrome",
        "firefox",
        "safari",
        "edge",
        "ios",
        "android",
        "random"
      ],
      "default": "chrome",
      "ui_group": "tls",
      "ui_order": 90,
      "title": {
        "en": "uTLS fingerprint",
        "ru": "uTLS fingerprint"
      },
      "description": {
        "en": "Outbound uTLS ClientHello fingerprint.",
        "ru": "uTLS fingerprint ClientHello на outbound."
      },
      "help": {
        "summary": {
          "en": "Outbound uTLS fingerprint. Override the template default (usually chrome).",
          "ru": "uTLS fingerprint на outbound. Переопределяет default шаблона (обычно chrome)."
        },
        "input_hint": {
          "en": "chrome|firefox|…",
          "ru": "chrome|firefox|…"
        },
        "format": "chrome"
      }
    }
  }
}
