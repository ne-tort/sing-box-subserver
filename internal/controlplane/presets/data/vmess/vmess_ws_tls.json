{
  "schema_version": 1,
  "tag": "vmess_ws_tls",
  "protocol": "vmess",
  "aliases": [
    "vmess-ws-tls"
  ],
  "short_name": "VMess WS",
  "status": "stable",
  "i18n": {
    "ru": {
      "title": "VMess WebSocket TLS",
      "description": "VMess + TLS + WebSocket."
    }
  },
  "traits": [
    "tcp",
    "tls",
    "ws"
  ],
  "demux_hints": {
    "network": [
      "tcp"
    ],
    "looks_like": "tls_clienthello",
    "alpn": [],
    "sni_required": true,
    "first_bytes": "TLS then ws",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 6,
    "speed": 6,
    "mobile": 5,
    "setup": 6
  },
  "cred_fields": [
    "uuid"
  ],
  "default_client_profiles": [
    "sec-auto"
  ],
  "inbound_template": {
    "type": "vmess",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "users": [],
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ]
    },
    "transport": {
      "type": "ws",
      "path": "{{param.ws_path}}",
      "headers": {
        "Host": [
          "{{param.ws_host}}"
        ],
        "User-Agent": [
          "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
        ]
      },
      "max_early_data": 2048,
      "early_data_header_name": "Sec-WebSocket-Protocol"
    }
  },
  "outbound_template": {
    "type": "vmess",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "uuid": "{{user.uuid}}",
    "security": "auto",
    "tls": {
      "enabled": true,
      "server_name": "{{server}}",
      "alpn": [
        "h2",
        "http/1.1"
      ],
      "utls": {
        "enabled": true,
        "fingerprint": "chrome"
      }
    },
    "transport": {
      "type": "ws",
      "path": "{{param.ws_path}}",
      "headers": {
        "Host": [
          "{{param.ws_host}}"
        ],
        "User-Agent": [
          "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
        ]
      },
      "max_early_data": 2048,
      "early_data_header_name": "Sec-WebSocket-Protocol"
    }
  },
  "requirements": {
    "tls_profile": true
  },
  "client_notes": {
    "security": "outbound-only: sec-auto / sec-aes128 / sec-chacha / pkt-xudp через enabled_client_profiles",
    "params": "optional bindings[].params overrides: ws_host, ws_path",
    "ws_path_default": "/vmess"
  }
}
