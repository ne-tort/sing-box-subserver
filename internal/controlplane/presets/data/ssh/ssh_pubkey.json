{
  "schema_version": 1,
  "tag": "ssh_pubkey",
  "protocol": "ssh",
  "aliases": [
    "ssh-pubkey",
    "ssh-key"
  ],
  "short_name": "SSH pubkey",
  "status": "lab",
  "i18n": {
    "ru": {
      "title": "SSH public key",
      "description": "SSH inbound: user + authorized public_key; outbound private_key (ed25519 auto)."
    },
    "en": {
      "title": "SSH pubkey",
      "description": "SSH inbound with public-key auth. Same plain SSH fingerprint as password variant."
    }
  },
  "traits": [
    "tcp",
    "pubkey"
  ],
  "demux_hints": {
    "network": [
      "tcp"
    ],
    "looks_like": "ssh_banner",
    "alpn": [],
    "sni_required": false,
    "first_bytes": "SSH-2.0 banner",
    "compatible_with_demux": true
  },
  "scores": {
    "dpi": 4,
    "speed": 5,
    "mobile": 4,
    "setup": 3
  },
  "cred_fields": [
    "username",
    "private_key",
    "public_key"
  ],
  "cred_generators": {
    "private_key": "ssh_ed25519"
  },
  "inbound_template": {
    "type": "ssh",
    "tag": "{{tag}}",
    "listen": "{{listen}}",
    "listen_port": 0,
    "users": [],
    "server_version": "{{param.server_version}}"
  },
  "outbound_template": {
    "type": "ssh",
    "tag": "{{tag}}",
    "server": "{{server}}",
    "server_port": 0,
    "user": "{{user.username}}",
    "private_key": [
      "{{user.private_key}}"
    ],
    "client_version": "{{param.client_version}}"
  },
  "requirements": {
    "build_tag": "with_ssh"
  },
  "client_notes": {
    "keys": "ensureCreds генерирует ed25519 PEM + authorized_keys; inbound users[].public_key",
    "params": "optional: server_version (inbound banner), client_version (outbound)"
  },
  "optional_param_fields": [
    "server_version",
    "client_version"
  ],
  "param_meta": {
    "server_version": {
      "type": "string",
      "widget": "text",
      "default": "SSH-2.0-OpenSSH_8.9",
      "ui_group": "banner",
      "ui_order": 43,
      "title": {
        "en": "SSH banner",
        "ru": "SSH banner"
      },
      "description": {
        "en": "SSH version banner shown to clients.",
        "ru": "SSH version banner для клиентов."
      },
      "help": {
        "summary": {
          "en": "SSH identification string (banner) returned on connect. Keep OpenSSH-like unless you need a specific fingerprint.",
          "ru": "Строка идентификации SSH (banner) при connect. Держите OpenSSH-like, если не нужен особый fingerprint."
        },
        "input_hint": {
          "en": "SSH-2.0-…",
          "ru": "SSH-2.0-…"
        },
        "format": "SSH-2.0-OpenSSH_8.9"
      }
    },
    "client_version": {
      "type": "string",
      "widget": "text",
      "default": "SSH-2.0-OpenSSH_8.9",
      "ui_group": "banner",
      "ui_order": 44,
      "title": {
        "en": "Client version",
        "ru": "Client version"
      },
      "description": {
        "en": "SSH client identification string on outbound.",
        "ru": "Строка идентификации SSH-клиента на outbound."
      },
      "help": {
        "summary": {
          "en": "Outbound SSH client banner. Can differ from server_version when probing mixed OpenSSH fingerprints.",
          "ru": "Banner SSH-клиента на outbound. Может отличаться от server_version при смешанных OpenSSH fingerprint."
        },
        "input_hint": {
          "en": "SSH-2.0-…",
          "ru": "SSH-2.0-…"
        },
        "format": "SSH-2.0-OpenSSH_8.9"
      }
    }
  }
}
