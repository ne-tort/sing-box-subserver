          "h2"
        ],
        "certificate_path": "/work/certs/server.crt",
        "key_path": "/work/certs/server.key"
      },
      "transport": {
        "type": "grpc",
        "service_name": "GunService",
        "idle_timeout": "15s",
        "ping_timeout": "15s",
        "permit_without_stream": false
      }
    },
    {
      "type": "anytls",
      "tag": "anytls",
