{
  "log": {
    "level": "warn"
  },
  "inbounds": [
    {
      "type": "demux",
      "tag": "cp-demux-dg-matrix",
      "listen": "0.0.0.0",
      "listen_port": 1443,
      "network": [
        "tcp",
        "udp"
      ],
      "inspect_timeout": "3s",
      "rules": [
        {
          "action": {
            "dial": {
              "address": "127.0.0.1",
              "port": 55330
            }
          },
          "match": {
            "protocol": "quic"
          },
          "name": "quic-quic"
        },
        {
          "action": {
            "dial": {
              "address": "127.0.0.1",
              "port": 51074
            }
          },
          "match": {
            "always": true
          },
          "name": "plain-snell"
        }
      ]
    },
    {
      "type": "snell",
      "tag": "snell_v5",
      "listen": "127.0.0.1",
      "listen_port": 51074,
      "version": 5,
      "psk": "3af6e37d077385ca3a8b3b7115557986",
      "users": [
        {
          "name": "u1",
          "userkey": "matrix-pass-1"
        }
      ],
      "obfs_mode": "http"
    },
    {
      "type": "hysteria2",
      "tag": "hy2",
      "listen": "127.0.0.1",
      "listen_port": 55330,
      "users": [
        {
          "name": "u1",
          "password": "matrix-pass-1"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "matrix.local",
        "alpn": [
          "h3"
        ],
        "certificate_path": "/work/certs/server.crt",
        "key_path": "/work/certs/server.key"
      },
      "ignore_client_bandwidth": true,
      "up_mbps": 100,
      "down_mbps": 100
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ]
}
